---
import Base from '../layouts/Base.astro';
import { listGPs, loadH2HIndex, listDriverPairs, listDriverTriples, listGPsWithCards, TEAM_COLORS, TEAM_SHORT } from '../lib/data';

const gps = listGPs();
const gpData = gps
  .map(gp => ({
    ...gp,
    index: loadH2HIndex(gp.dir_name),
  }))
  .filter(gp => gp.index !== null);

// 統計
const totalPairs = gpData.reduce((sum, gp) => sum + (gp.index?.meta.total_pairs ?? 0), 0);
const driverPairCount = listDriverPairs().length;
const tripleCount = listDriverTriples().length;
const cardGPs = listGPsWithCards();
---

<Base title="F1 Data Lab — データで読む F1" description="F1レースペース・ドライバー比較・タイヤ戦略をデータで分析。6,000+ページの自動生成分析プラットフォーム。" url="/" type="website">

<!-- ===== ヒーロー ===== -->
<section class="hero">
  <div class="hero-badge">2026 Season</div>
  <h1 class="hero-title">
    <span class="hero-line1">Data-Driven</span>
    <span class="hero-line2">F1 Analysis</span>
  </h1>
  <p class="hero-sub">レースペース・予選シミュレーション・タイヤ戦略を<br>データで可視化する分析プラットフォーム</p>
  <div class="hero-stats">
    <div class="hero-stat">
      <span class="hero-stat-num">{gpData.length}</span>
      <span class="hero-stat-label">Grands Prix</span>
    </div>
    <div class="hero-stat-divider"></div>
    <div class="hero-stat">
      <span class="hero-stat-num">{totalPairs}</span>
      <span class="hero-stat-label">H2H Pairs</span>
    </div>
    <div class="hero-stat-divider"></div>
    <div class="hero-stat">
      <span class="hero-stat-num">{driverPairCount}</span>
      <span class="hero-stat-label">Driver Matchups</span>
    </div>
    <div class="hero-stat-divider"></div>
    <div class="hero-stat">
      <span class="hero-stat-num">{tripleCount}</span>
      <span class="hero-stat-label">Triple Comps</span>
    </div>
  </div>
</section>

<!-- ===== コンテンツタイプ ===== -->
<section class="content-types">
  <a href="#races" class="type-card">
    <div class="type-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    </div>
    <div class="type-info">
      <span class="type-name">Race H2H</span>
      <span class="type-desc">チームメイト同士のレースペース直接比較</span>
    </div>
    <span class="type-count">{totalPairs} pairs</span>
  </a>
  <a href="/compare/drivers/" class="type-card">
    <div class="type-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <div class="type-info">
      <span class="type-name">Driver Compare</span>
      <span class="type-desc">歴代ドライバーのキャリア・実績比較</span>
    </div>
    <span class="type-count">{driverPairCount} pairs</span>
  </a>
  <a href="/season/" class="type-card">
    <div class="type-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <div class="type-info">
      <span class="type-name">Season</span>
      <span class="type-desc">シーズン通しての傾向・統計</span>
    </div>
    <span class="type-count">2026</span>
  </a>
</section>

<!-- ===== レースH2Hセクション ===== -->
<section id="races" class="races-section">
  <h2 class="section-heading">
    <span class="section-heading-accent"></span>
    Race H2H Analysis
  </h2>

  {gpData.map((gp, i) => (
    <div class="gp-block" style={`animation-delay: ${i * 60}ms;`}>
      <div class="gp-header">
        <div class="gp-round">R{String(gp.round).padStart(2, '0')}</div>
        <div class="gp-info">
          <h3 class="gp-name">{gp.gp_name} Grand Prix</h3>
          <span class="gp-meta">{gp.index!.meta.total_laps} Laps &middot; {gp.index!.meta.total_pairs} Matchups</span>
        </div>
      </div>

      <div class="pairs-grid">
        {gp.index!.pairs.map(pair => {
          const color1 = TEAM_COLORS[pair.team1] || '#999';
          const color2 = TEAM_COLORS[pair.team2] || '#999';
          const delta = pair.delta_median_sec;
          const slug = `${gp.year}-r${String(gp.round).padStart(2, '0')}-${gp.gp_name.toLowerCase()}/${pair.driver1.toLowerCase()}-vs-${pair.driver2.toLowerCase()}`;

          return (
            <a href={`/h2h/${slug}/`} class="pair-card">
              <div class="pair-top">
                <div class="pair-driver">
                  <span class="pair-color" style={`background: ${color1};`}></span>
                  <span class="pair-name">{pair.driver1}</span>
                  <span class="pair-team">{TEAM_SHORT[pair.team1] || pair.team1}</span>
                </div>
                <span class="pair-vs">VS</span>
                <div class="pair-driver pair-driver-right">
                  <span class="pair-team">{TEAM_SHORT[pair.team2] || pair.team2}</span>
                  <span class="pair-name">{pair.driver2}</span>
                  <span class="pair-color" style={`background: ${color2};`}></span>
                </div>
              </div>
              {delta !== null && (
                <div class="pair-bottom">
                  <span class={`pair-delta ${delta < 0 ? 'faster-1' : delta > 0 ? 'faster-2' : ''}`}>
                    {delta > 0 ? '+' : ''}{delta.toFixed(3)}s
                  </span>
                  <span class="pair-faster">{pair.faster} faster</span>
                </div>
              )}
            </a>
          );
        })}
      </div>
    </div>
  ))}
</section>

</Base>

<style>
  /* ===== ヒーロー ===== */
  .hero {
    text-align: center;
    padding: 56px 0 48px;
    position: relative;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    padding: 4px 14px;
    border-radius: 4px;
    margin-bottom: 20px;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    line-height: 1.1;
    margin-bottom: 16px;
    font-family: var(--font-display);
  }
  .hero-line1 {
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--text);
    text-transform: uppercase;
  }
  .hero-line2 {
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    background: linear-gradient(135deg, var(--accent), #ff4d4d);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    color: var(--text-dim);
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 36px;
    flex-wrap: wrap;
  }
  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .hero-stat-num {
    font-size: 1.8rem;
    font-weight: 800;
    font-family: var(--font-display);
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .hero-stat-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
    font-family: var(--font-display);
  }
  .hero-stat-divider {
    width: 1px;
    height: 32px;
    background: var(--border);
  }

  /* ===== コンテンツタイプ ===== */
  .content-types {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
    margin-bottom: 48px;
  }

  .type-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: var(--bg-card);
    border: none;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    border-radius: 0 0 8px 0;
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--transition-normal) var(--ease-out), background var(--transition-normal) var(--ease-out), transform var(--transition-normal) var(--ease-out);
  }
  .type-card:hover {
    border-right-color: var(--accent);
    border-bottom-color: var(--accent);
    background: var(--bg-card-hover);
    text-decoration: none;
    transform: translateY(-2px);
  }
  .type-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .type-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .type-name {
    font-size: 0.95rem;
    font-weight: 700;
  }
  .type-desc {
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .type-count {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ===== セクション見出し ===== */
  .section-heading {
    font-size: 1.3rem;
    font-weight: 800;
    font-family: var(--font-display);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    letter-spacing: -0.01em;
  }
  .section-heading-accent {
    display: inline-block;
    width: var(--racing-line-md);
    height: 20px;
    background: var(--accent);
    border-radius: 2px;
  }

  /* ===== レースセクション ===== */
  .races-section { margin-bottom: 48px; }

  .gp-block {
    margin-bottom: 36px;
    animation: fadeInUp 0.4s ease both;
  }

  .gp-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }
  .gp-round {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 0.03em;
  }
  .gp-info { display: flex; flex-direction: column; gap: 1px; }
  .gp-name {
    font-size: 1.15rem;
    font-weight: 700;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .gp-meta {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  /* ===== ペアカード ===== */
  .pairs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 10px;
  }

  .pair-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
    text-decoration: none;
    color: var(--text);
  }
  .pair-card:hover {
    background: var(--bg-card-hover);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    text-decoration: none;
    transform: translateY(-1px);
  }

  .pair-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .pair-driver {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }
  .pair-driver-right {
    justify-content: flex-end;
    text-align: right;
  }
  .pair-color {
    display: inline-block;
    width: 3px;
    height: 18px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .pair-name {
    font-weight: 700;
    font-size: 1rem;
    white-space: nowrap;
  }
  .pair-team {
    font-size: 0.65rem;
    color: var(--text-dim);
    font-weight: 400;
    white-space: nowrap;
  }
  .pair-vs {
    font-size: 0.7rem;
    font-weight: 800;
    color: color-mix(in srgb, var(--text-dim) 60%, transparent);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .pair-bottom {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .pair-delta {
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .pair-delta.faster-1 { color: var(--accent); }
  .pair-delta.faster-2 { color: var(--accent-2); }
  .pair-faster {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 640px) {
    .hero { padding: 36px 0 32px; }
    .hero-stats { gap: 16px; }
    .hero-stat-num { font-size: 1.4rem; }
    .hero-stat-divider { height: 24px; }
    .pairs-grid { grid-template-columns: 1fr; }
    .content-types { grid-template-columns: 1fr; }
  }
</style>
