---
interface Props { text: string; }
const { text } = Astro.props;
---
<div class="insight-box">
  {text}
</div>

<style>
  .insight-box {
    background: linear-gradient(135deg, rgba(225, 6, 0, 0.06), rgba(255, 45, 39, 0.06));
    border: 1px solid rgba(225, 6, 0, 0.2);
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 24px;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text);
  }
</style>
