---
import Base from '../../../layouts/Base.astro';
import SubNav from '../../../components/SubNav.astro';
import ChartGuide from '../../../components/ChartGuide.astro';
import InsightBox from '../../../components/InsightBox.astro';
import { getH2HStaticPaths, loadH2HAnalysis, TEAM_COLORS, DRIVER_HEADSHOTS } from '../../../lib/data';
import { sectorInsight } from '../../../lib/insights';

export function getStaticPaths() { return getH2HStaticPaths(); }

const { dirName, pairDir } = Astro.props;
const analysis = loadH2HAnalysis(dirName, pairDir);
if (!analysis) return Astro.redirect('/');

const { meta, sectors, seo } = analysis;
const drv1 = meta.driver1, drv2 = meta.driver2;
const color1 = TEAM_COLORS[meta.team1] || '#999';
const color2 = TEAM_COLORS[meta.team2] || '#999';
const basePath = `/h2h/${meta.year}-r${String(meta.round).padStart(2, '0')}-${meta.gp_name.toLowerCase()}/${drv1.toLowerCase()}-vs-${drv2.toLowerCase()}/`;

const insight = sectorInsight(analysis);

// --- ヒーロー: セクター合計勝利数で勝者判定 ---
const sectorEntries = Object.entries(sectors) as [string, any][];
const d1TotalWins = sectorEntries.reduce((s, [, d]) => s + (d[`${drv1}_wins`] ?? 0), 0);
const d2TotalWins = sectorEntries.reduce((s, [, d]) => s + (d[`${drv2}_wins`] ?? 0), 0);
const sectorWinner = d1TotalWins > d2TotalWins ? 1 : d2TotalWins > d1TotalWins ? 2 : 0;

// 累積デルタ秒数
const totalDelta = sectorEntries.reduce((s, [, d]) => s + (d.delta_sec ?? 0), 0);
const d1DeltaStr = totalDelta < 0 ? `${totalDelta.toFixed(3)}s` : `+${totalDelta.toFixed(3)}s`;
const d2DeltaStr = totalDelta > 0 ? `${(-totalDelta).toFixed(3)}s` : `+${(-totalDelta).toFixed(3)}s`;

// ヘッドショット
const face1 = DRIVER_HEADSHOTS[drv1] || '';
const face2 = DRIVER_HEADSHOTS[drv2] || '';

// --- スコアカード行データ ---
interface ScoreRow {
  label: string;
  sub: string;
  subColor: string;
  val1: string;
  val2: string;
  scale1: number;
  scale2: number;
  opacity1: number;
  opacity2: number;
  fontSize1: number;
  fontSize2: number;
}

function makeRow(
  label: string, sub: string, subColor: string,
  val1: string, val2: string,
  v1: number, v2: number, maxDelta: number, lowerIsBetter: boolean
): ScoreRow {
  const diff = v1 - v2;
  const intensity = Math.min(Math.abs(diff) / maxDelta, 1);
  const winner = lowerIsBetter
    ? (diff < 0 ? 1 : diff > 0 ? 2 : 0)
    : (diff > 0 ? 1 : diff < 0 ? 2 : 0);

  const winScale = 0.6 + intensity * 0.4;
  const loseScale = 0.6 - intensity * 0.35;
  const drawScale = 0.5;

  const winOpacity = 1;
  const loseOpacity = 0.7 - intensity * 0.35;

  const winFont = 0.85 + intensity * 0.25;
  const loseFont = 0.85 - intensity * 0.15;

  return {
    label, sub, subColor, val1, val2,
    scale1: winner === 1 ? winScale : winner === 2 ? loseScale : drawScale,
    scale2: winner === 2 ? winScale : winner === 1 ? loseScale : drawScale,
    opacity1: winner === 2 ? loseOpacity : winOpacity,
    opacity2: winner === 1 ? loseOpacity : winOpacity,
    fontSize1: winner === 1 ? winFont : winner === 2 ? loseFont : 0.85,
    fontSize2: winner === 2 ? winFont : winner === 1 ? loseFont : 0.85,
  };
}

// セクター行（S1, S2, S3）
const sectorRows = sectorEntries.map(([name, data]: [string, any]) => {
  const d1W = data[`${drv1}_wins`] ?? 0;
  const d2W = data[`${drv2}_wins`] ?? 0;
  const total = d1W + d2W;
  const delta = data.delta_sec ?? 0;
  return makeRow(
    name,
    `${delta > 0 ? '+' : ''}${delta.toFixed(3)}s`,
    delta < 0 ? color1 : color2,
    `${d1W} wins`, `${d2W} wins`,
    d1W, d2W, Math.max(total, 1), false
  );
});

// チャート用データ
const chartData = {
  sectors: analysis.per_lap.sectors,
  meta: { driver1: drv1, driver2: drv2, vsc_periods: meta.vsc_periods, sc_periods: meta.sc_periods, total_laps: meta.total_laps },
  color1, color2,
  summary: analysis.sectors,
};
---

<Base title={`${drv1} vs ${drv2} セクター分析 — ${meta.year} ${meta.gp_name}GP`} description={seo.description} keywords={seo.keywords}>

<nav class="breadcrumb">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
  <a href="/">Home</a> &rsaquo;
  <a href={basePath}>{drv1} vs {drv2}</a> &rsaquo;
  <span>Sectors</span>
</nav>

<!-- ===== ヒーロー ===== -->
<header class="hero">
  <div class={`hero-driver ${sectorWinner === 1 ? 'winner' : sectorWinner === 2 ? 'loser' : ''}`}>
    <div class="hero-portrait" style={`border-color: ${color1};`}>
      {face1 && <img src={face1} alt={drv1} />}
    </div>
    <span class="hero-name" style={`color: ${color1};`}>{drv1}</span>
    <div class="hero-result">
      <span class="hero-pace">{d1DeltaStr}</span>
    </div>
  </div>

  <div class="hero-center">
    <span class="hero-vs">VS</span>
    <span class="hero-gp">{meta.year} R{String(meta.round).padStart(2, '0')}</span>
    <span class="hero-gp-name">{meta.gp_name} GP</span>
    <span class="hero-page-type">Sectors</span>
  </div>

  <div class={`hero-driver ${sectorWinner === 2 ? 'winner' : sectorWinner === 1 ? 'loser' : ''}`}>
    <div class="hero-portrait" style={`border-color: ${color2};`}>
      {face2 && <img src={face2} alt={drv2} />}
    </div>
    <span class="hero-name" style={`color: ${color2};`}>{drv2}</span>
    <div class="hero-result">
      <span class="hero-pace">{d2DeltaStr}</span>
    </div>
  </div>
</header>

<SubNav basePath={basePath} current="sectors" drv1={drv1} drv2={drv2} />

<!-- ===== セクターサマリーカード ===== -->
<div class="scorecard">
  {sectorRows.map((row) => (
    <div class="score-row" style={`--s1: ${row.scale1}; --s2: ${row.scale2}; --o1: ${row.opacity1}; --o2: ${row.opacity2}; --fs1: ${row.fontSize1}rem; --fs2: ${row.fontSize2}rem;`}>
      <div class="score-side score-left">
        <div class="face-dot face-dot-1" style={`border-color: ${color1};`}>
          {face1 && <img src={face1} alt={drv1} />}
        </div>
        <span class="score-val score-val-1">{row.val1}</span>
      </div>

      <div class="score-center">
        <span class="score-title">{row.label}</span>
        <span class="score-sub" style={`color: ${row.subColor};`}>{row.sub}</span>
      </div>

      <div class="score-side score-right">
        <span class="score-val score-val-2">{row.val2}</span>
        <div class="face-dot face-dot-2" style={`border-color: ${color2};`}>
          {face2 && <img src={face2} alt={drv2} />}
        </div>
      </div>
    </div>
  ))}
</div>

<ChartGuide text={`各セクターの所要時間を比較。下のバーが0より下なら${drv1}が速い、上なら${drv2}が速い。`} />

<InsightBox text={insight} />

<div id="chart-s1" class="sector-chart"></div>
<div id="chart-s2" class="sector-chart"></div>
<div id="chart-s3" class="sector-chart"></div>

<script type="application/json" id="chart-data" set:html={JSON.stringify(chartData)} />

<script>
  import * as echarts from 'echarts/core';
  import { BarChart } from 'echarts/charts';
  import { GridComponent, TooltipComponent, LegendComponent, MarkAreaComponent, DataZoomComponent } from 'echarts/components';
  import { CanvasRenderer } from 'echarts/renderers';

  echarts.use([BarChart, GridComponent, TooltipComponent, LegendComponent, MarkAreaComponent, DataZoomComponent, CanvasRenderer]);

  const data = JSON.parse(document.getElementById('chart-data')!.textContent!);
  const { sectors, meta, color1, color2, summary } = data;

  const charts: echarts.ECharts[] = [];

  function neutralAreas() {
    const areas: any[] = [];
    for (const [s, e] of meta.vsc_periods) areas.push([{ xAxis: s, itemStyle: { color: 'rgba(255,200,0,0.05)' } }, { xAxis: e }]);
    for (const [s, e] of meta.sc_periods) areas.push([{ xAxis: s, itemStyle: { color: 'rgba(255,200,0,0.1)' } }, { xAxis: e }]);
    return areas;
  }

  for (const [secName, secData] of Object.entries(sectors) as [string, any][]) {
    const el = document.getElementById(`chart-${secName.toLowerCase()}`);
    if (!el) continue;

    const chart = echarts.init(el, undefined, { renderer: 'canvas' });
    const secSummary = summary[secName];
    const deltaSign = secSummary.delta_sec < 0 ? '' : '+';
    const winner = secSummary.delta_sec < 0 ? meta.driver1 : meta.driver2;

    chart.setOption({
      textStyle: { color: '#aaaaaa', fontFamily: 'Hiragino Sans, system-ui, sans-serif' },
      tooltip: {
        backgroundColor: '#1c1c25', borderColor: '#303037', borderWidth: 1, textStyle: { color: '#fff', fontSize: 13 },
        trigger: 'axis',
        formatter: (params: any) => {
          const p = Array.isArray(params) ? params[0] : params;
          const d = p.value;
          const sign = d[1] > 0 ? '+' : '';
          const f = d[1] < 0 ? meta.driver1 : meta.driver2;
          return `${secName} Lap ${d[0]}: ${sign}${d[1].toFixed(3)}s<br/>${f} faster`;
        },
      },
      title: {
        text: `${secName}  ${deltaSign}${secSummary.delta_sec.toFixed(3)}s (${winner})`,
        left: 'center',
        textStyle: { color: '#ffffff', fontSize: 14, fontWeight: 'bold' },
      },
      grid: { left: 60, right: 20, top: 40, bottom: 40 },
      xAxis: {
        type: 'value', min: 1, max: meta.total_laps,
        name: 'Lap', nameLocation: 'center', nameGap: 25,
        nameTextStyle: { color: '#aaaaaa' },
        axisLine: { lineStyle: { color: '#303037' } },
        axisLabel: { color: '#aaaaaa' },
        splitLine: { show: false },
      },
      yAxis: {
        type: 'value',
        name: `\u2190 ${meta.driver1}  |  ${meta.driver2} \u2192`,
        nameTextStyle: { color: '#aaaaaa', fontSize: 11 },
        axisLine: { lineStyle: { color: '#303037' } },
        axisLabel: { color: '#aaaaaa', formatter: (v: number) => v.toFixed(2) },
        splitLine: { lineStyle: { color: '#303037', type: 'dashed' } },
      },
      series: [{
        type: 'bar',
        data: secData.deltas.map((d: any) => ({
          value: [d.lap, d.delta],
          itemStyle: { color: d.delta < 0 ? color1 : color2 },
        })),
        barMaxWidth: 8,
        markArea: { silent: true, data: neutralAreas() },
      }],
    });

    charts.push(chart);
  }

  window.addEventListener('resize', () => charts.forEach(c => c.resize()));
</script>

</Base>

<style>
  .breadcrumb { font-size: 0.85rem; color: var(--text-dim); margin-bottom: 24px; display: flex; align-items: center; gap: 6px; }
  .breadcrumb a { color: var(--text-dim); }

  /* ===== ヒーロー ===== */
  .hero {
    display: flex; align-items: center; justify-content: center; gap: 20px;
    margin-bottom: 24px; padding: 12px 0;
  }
  .hero-driver {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    min-width: 80px; transition: all 0.3s;
  }
  .hero-driver.winner .hero-portrait { width: 56px; height: 56px; }
  .hero-driver.winner .hero-name { font-size: 1.3rem; }
  .hero-driver.loser .hero-portrait { width: 44px; height: 44px; opacity: 0.6; }
  .hero-driver.loser .hero-name { font-size: 1rem; opacity: 0.6; }
  .hero-driver:not(.winner):not(.loser) .hero-portrait { width: 48px; height: 48px; }
  .hero-driver:not(.winner):not(.loser) .hero-name { font-size: 1.15rem; }

  .hero-portrait {
    border-radius: 50%; overflow: hidden; border: 3px solid;
    background: var(--bg-card);
  }
  .hero-portrait img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .hero-name { font-weight: 800; }
  .hero-result { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; }
  .hero-pace {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.8rem; color: var(--text-dim); font-weight: 600;
  }

  .hero-center { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .hero-vs { font-size: 1.2rem; font-weight: 900; color: var(--text-dim); letter-spacing: 0.1em; }
  .hero-gp { font-size: 0.7rem; color: var(--text-dim); }
  .hero-gp-name { font-size: 0.85rem; color: var(--text-dim); font-weight: 600; }
  .hero-page-type {
    font-size: 0.75rem; font-weight: 600; color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 1px 8px; border-radius: 4px; margin-top: 2px;
  }

  /* ===== スコアカード ===== */
  .scorecard {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
    overflow: hidden; margin-bottom: 24px;
  }

  .score-row {
    display: flex; align-items: center; padding: 12px 20px;
    border-bottom: 1px solid var(--border);
  }
  .score-row:last-child { border-bottom: none; }

  .score-row {
    --face-base: clamp(28px, 6vw, 44px);
  }

  .score-side {
    flex: 1; display: flex; align-items: center; gap: clamp(6px, 1.5vw, 12px);
  }
  .score-left { justify-content: flex-start; opacity: var(--o1); }
  .score-right { justify-content: flex-end; opacity: var(--o2); }

  .face-dot {
    border-radius: 50%; flex-shrink: 0; overflow: hidden;
    border: 2px solid; background: var(--bg-card);
    transition: all 0.3s ease;
  }
  .face-dot-1 {
    width: calc(var(--face-base) * var(--s1));
    height: calc(var(--face-base) * var(--s1));
  }
  .face-dot-2 {
    width: calc(var(--face-base) * var(--s2));
    height: calc(var(--face-base) * var(--s2));
  }
  .face-dot img {
    width: 100%; height: 100%; object-fit: cover; object-position: center top;
    display: block;
  }

  .score-val {
    font-family: 'SF Mono', 'Fira Code', monospace;
    color: var(--text); white-space: nowrap;
    transition: font-size 0.3s;
  }
  .score-val-1 { font-size: var(--fs1); font-weight: calc(400 + var(--s1) * 400); }
  .score-val-2 { font-size: var(--fs2); font-weight: calc(400 + var(--s2) * 400); }

  .score-center {
    min-width: clamp(70px, 12vw, 110px); text-align: center;
    display: flex; flex-direction: column; gap: 1px; flex-shrink: 0;
  }
  .score-title {
    font-size: clamp(0.65rem, 1.5vw, 0.8rem); font-weight: 700; color: var(--text);
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .score-sub { font-size: clamp(0.58rem, 1.2vw, 0.7rem); font-weight: 700; }

  /* ===== レスポンシブ ===== */
  @media (max-width: 640px) {
    .hero { gap: 10px; padding: 8px 0; }
    .hero-driver { min-width: 60px; }
    .hero-driver.winner .hero-portrait { width: 44px; height: 44px; }
    .hero-driver.winner .hero-name { font-size: 1.1rem; }
    .hero-driver.loser .hero-portrait { width: 32px; height: 32px; }
    .hero-driver.loser .hero-name { font-size: 0.85rem; }
    .hero-vs { font-size: 1rem; }

    .score-row { padding: 10px 12px; --face-base: 32px; }
  }
</style>
