---
import Base from '../layouts/Base.astro';
import { listGPs, loadH2HIndex, TEAM_COLORS, TEAM_SHORT } from '../lib/data';

const gps = listGPs();
const gpData = gps
  .map(gp => ({
    ...gp,
    index: loadH2HIndex(gp.dir_name),
  }))
  .filter(gp => gp.index !== null);
---

<Base title="F1 Data Lab - Race Pace Analysis" description="F1レースペースのデータ分析。ドライバー間H2H比較、セクター分析、スピード比較。">

<section class="hero">
  <h1>F1 Data Lab</h1>
  <p class="subtitle">pSEO 2.0 powered race pace analysis</p>
  <div class="stats">
    <div class="stat">
      <span class="stat-num">{gpData.reduce((sum, gp) => sum + (gp.index?.meta.total_pairs ?? 0), 0)}</span>
      <span class="stat-label">H2H Comparisons</span>
    </div>
    <div class="stat">
      <span class="stat-num">{gpData.length}</span>
      <span class="stat-label">Grand Prix</span>
    </div>
    <div class="stat">
      <span class="stat-num">{gpData.reduce((sum, gp) => sum + (gp.index?.meta.total_pairs ?? 0), 0) * 4}</span>
      <span class="stat-label">Charts</span>
    </div>
  </div>
</section>

{gpData.map(gp => (
  <section class="gp-section">
    <h2 class="gp-title">
      R{String(gp.round).padStart(2, '0')} {gp.gp_name}
      <span class="gp-meta">{gp.index!.meta.total_laps} Laps | {gp.index!.meta.total_pairs} Pairs</span>
    </h2>

    <div class="pairs-grid">
      {gp.index!.pairs.map(pair => {
        const color1 = TEAM_COLORS[pair.team1] || '#999';
        const color2 = TEAM_COLORS[pair.team2] || '#999';
        const delta = pair.delta_median_sec;
        const slug = `${gp.year}-r${String(gp.round).padStart(2, '0')}-${gp.gp_name.toLowerCase()}/${pair.driver1.toLowerCase()}-vs-${pair.driver2.toLowerCase()}`;

        return (
          <a href={`/h2h/${slug}/`} class="pair-card">
            <div class="pair-drivers">
              <span class="driver" style={`border-left: 3px solid ${color1};`}>
                {pair.driver1}
                <span class="team-tag">{TEAM_SHORT[pair.team1] || pair.team1}</span>
              </span>
              <span class="vs">vs</span>
              <span class="driver" style={`border-left: 3px solid ${color2};`}>
                {pair.driver2}
                <span class="team-tag">{TEAM_SHORT[pair.team2] || pair.team2}</span>
              </span>
            </div>
            {delta !== null && (
              <div class="pair-delta">
                <span class={`delta-value ${delta < 0 ? 'faster-1' : delta > 0 ? 'faster-2' : ''}`}>
                  {delta > 0 ? '+' : ''}{delta.toFixed(3)}s
                </span>
                <span class="delta-label">
                  {pair.faster} faster
                </span>
              </div>
            )}
          </a>
        );
      })}
    </div>
  </section>
))}

</Base>

<style>
  .hero {
    text-align: center;
    padding: 48px 0 40px;
  }

  .hero h1 {
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--accent), #3BA3E0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    color: var(--text-dim);
    font-size: 1.1rem;
    margin-top: 8px;
  }

  .stats {
    display: flex;
    justify-content: center;
    gap: 48px;
    margin-top: 32px;
  }

  .stat { display: flex; flex-direction: column; align-items: center; }
  .stat-num { font-size: 2rem; font-weight: 700; color: var(--accent); }
  .stat-label { font-size: 0.85rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; }

  .gp-section { margin-bottom: 48px; }

  .gp-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .gp-meta { font-size: 0.85rem; color: var(--text-dim); font-weight: 400; }

  .pairs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }

  .pair-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background 0.15s, border-color 0.15s;
    text-decoration: none;
    color: var(--text);
  }

  .pair-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent);
    text-decoration: none;
  }

  .pair-drivers { display: flex; align-items: center; gap: 8px; }

  .driver {
    font-weight: 700;
    font-size: 1.1rem;
    padding-left: 8px;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .team-tag { font-size: 0.7rem; color: var(--text-dim); font-weight: 400; }
  .vs { color: var(--text-dim); font-size: 0.8rem; }

  .pair-delta { display: flex; align-items: baseline; gap: 8px; }

  .delta-value {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .delta-value.faster-1 { color: var(--accent); }
  .delta-value.faster-2 { color: var(--accent-2); }
  .delta-label { font-size: 0.8rem; color: var(--text-dim); }
</style>
