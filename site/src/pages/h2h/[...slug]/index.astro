---
import Base from '../../../layouts/Base.astro';
import SubNav from '../../../components/SubNav.astro';
import { getH2HStaticPaths, loadH2HAnalysis, TEAM_COLORS, DRIVER_HEADSHOTS } from '../../../lib/data';
import { hubPaceOneLiner, hubSectorOneLiner, hubSpeedOneLiner, hubStintOneLiner } from '../../../lib/insights';

export function getStaticPaths() { return getH2HStaticPaths(); }

const { dirName, pairDir, gpMeta } = Astro.props;
const analysis = loadH2HAnalysis(dirName, pairDir);
if (!analysis) return Astro.redirect('/');

const { meta, race_result, pace, sectors, speed, seo } = analysis;
const drv1 = meta.driver1;
const drv2 = meta.driver2;
const color1 = TEAM_COLORS[meta.team1] || '#999';
const color2 = TEAM_COLORS[meta.team2] || '#999';
const r1 = race_result[drv1];
const r2 = race_result[drv2];
const totalLaps = meta.total_laps;
const basePath = `/h2h/${meta.year}-r${String(meta.round).padStart(2, '0')}-${meta.gp_name.toLowerCase()}/${drv1.toLowerCase()}-vs-${drv2.toLowerCase()}/`;

// --- ヘッダー用：レース結果で勝った方を大きく ---
const raceWinner = r1.finish < r2.finish ? 1 : r2.finish < r1.finish ? 2 : 0;
const headSize1 = raceWinner === 1 ? 96 : raceWinner === 2 ? 68 : 80;
const headSize2 = raceWinner === 2 ? 96 : raceWinner === 1 ? 68 : 80;
const headOpacity1 = raceWinner === 2 ? 0.65 : 1;
const headOpacity2 = raceWinner === 1 ? 0.65 : 1;

// --- 比較行データ構築 ---
// 「勝者に視覚的重みを与える」ための共通計算
// intensity: 0〜1で差の大きさ（アイコンサイズ差に使う）
function compareMetric(v1: number, v2: number, maxDelta: number, lowerIsBetter = true) {
  const diff = v1 - v2;
  const absDiff = Math.abs(diff);
  const intensity = Math.min(absDiff / maxDelta, 1);
  const winner = lowerIsBetter
    ? (diff < 0 ? 1 : diff > 0 ? 2 : 0)
    : (diff > 0 ? 1 : diff < 0 ? 2 : 0);
  return { winner, intensity, diff: absDiff };
}

// ペース
const paceComp = compareMetric(
  pace.drv1.median, pace.drv2.median, 0.5, true
);

// セクター
const sectorComps = Object.entries(sectors).map(([name, data]: [string, any]) => {
  const d1Wins = data[`${drv1}_wins`] ?? 0;
  const d2Wins = data[`${drv2}_wins`] ?? 0;
  const total = d1Wins + d2Wins;
  const comp = compareMetric(d1Wins, d2Wins, total, false);
  return { name, d1Wins, d2Wins, total, comp, delta: data.delta_sec };
});

// スピード（STがあればメイン表示）
const speedEntries = Object.entries(speed) as [string, any][];
const speedComps = speedEntries.map(([label, data]) => {
  const v1 = data[`${drv1}_median`] ?? 0;
  const v2 = data[`${drv2}_median`] ?? 0;
  const comp = compareMetric(v1, v2, 15, false); // 15km/h差で最大
  return { label, v1, v2, comp, delta: data.delta_kmh };
});

// クリーンラップ比率
const cleanPct1 = pace.drv1.total_laps > 0 ? pace.drv1.clean_laps / pace.drv1.total_laps : 0;
const cleanPct2 = pace.drv2.total_laps > 0 ? pace.drv2.clean_laps / pace.drv2.total_laps : 0;
const cleanComp = compareMetric(cleanPct1, cleanPct2, 0.3, false);

// ポジション変動
function posChange(grid: number, finish: number) {
  const diff = grid - finish;
  if (diff > 0) return { arrow: '▲', cls: 'pos-up', text: `+${diff}` };
  if (diff < 0) return { arrow: '▼', cls: 'pos-down', text: `${diff}` };
  return { arrow: '—', cls: 'pos-same', text: '±0' };
}

// タイヤカラー
const TYRE_COLORS: Record<string, string> = {
  SOFT: '#FF3333', MEDIUM: '#FFD700', HARD: '#FFFFFF',
  INTERMEDIATE: '#39B54A', WET: '#0072CE',
};

// アイコンサイズ計算：勝者=大きい、敗者=小さい、差が大きいほど差が顕著
// base: 24px, 勝者は +intensityで最大36px、敗者は -intensityで最小16px
function iconSizes(winner: number, intensity: number): [number, number] {
  const boost = Math.round(intensity * 10);
  if (winner === 1) return [24 + boost, 24 - boost];
  if (winner === 2) return [24 - boost, 24 + boost];
  return [24, 24];
}

// 明度：勝者=明るい、敗者=暗い
function opacities(winner: number, intensity: number): [number, number] {
  const dim = 0.35 + (1 - intensity) * 0.3; // 0.35〜0.65
  if (winner === 1) return [1, dim];
  if (winner === 2) return [dim, 1];
  return [0.8, 0.8];
}

// ナビカードアイコン
const navIcons: Record<string, string> = {
  Pace: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  Sectors: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20"/><line x1="12" y1="2" x2="12" y2="12"/><line x1="12" y1="12" x2="22" y2="12"/></svg>`,
  Speed: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  Stints: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1.5" fill="currentColor"/><circle cx="4" cy="12" r="1.5" fill="currentColor"/><circle cx="4" cy="18" r="1.5" fill="currentColor"/></svg>`,
};
const subPages = [
  { href: `${basePath}pace/`, label: 'Pace', desc: hubPaceOneLiner(analysis), icon: navIcons.Pace },
  { href: `${basePath}sectors/`, label: 'Sectors', desc: hubSectorOneLiner(analysis), icon: navIcons.Sectors },
  { href: `${basePath}speed/`, label: 'Speed', desc: hubSpeedOneLiner(analysis), icon: navIcons.Speed },
  { href: `${basePath}stints/`, label: 'Stints', desc: hubStintOneLiner(analysis), icon: navIcons.Stints },
];

const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: seo.title, description: seo.description, keywords: seo.keywords.join(', ') };
---

<Base title={seo.title_ja} description={seo.description} keywords={seo.keywords}>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<nav class="breadcrumb">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
  <a href="/">Home</a> &rsaquo;
  <a href="/">R{String(meta.round).padStart(2, '0')} {meta.gp_name}</a> &rsaquo;
  <span>{drv1} vs {drv2}</span>
</nav>

<!-- ===== ヒーロー：勝者が大きい ===== -->
<header class="hero">
  <div class="hero-driver">
    <div class="hero-portrait" style={`
      width: ${headSize1}px; height: ${headSize1}px;
      border-color: ${color1};
      opacity: ${headOpacity1};
    `}>
      {DRIVER_HEADSHOTS[drv1] && <img src={DRIVER_HEADSHOTS[drv1]} alt={drv1} />}
    </div>
    <span class="hero-name" style={`color: ${color1}; opacity: ${headOpacity1}; font-size: ${raceWinner === 1 ? '1.8rem' : raceWinner === 2 ? '1.2rem' : '1.5rem'};`}>{drv1}</span>
    <div class="hero-result">
      <span class="hero-pos" style={`background: ${color1};`}>P{r1.finish}</span>
      <span class={`hero-change ${posChange(r1.grid, r1.finish).cls}`}>
        {posChange(r1.grid, r1.finish).arrow}{posChange(r1.grid, r1.finish).text}
      </span>
    </div>
  </div>

  <div class="hero-center">
    <span class="hero-vs">VS</span>
    <span class="hero-gp">{meta.year} R{String(meta.round).padStart(2, '0')}</span>
    <span class="hero-gp-name">{meta.gp_name} GP</span>
  </div>

  <div class="hero-driver">
    <div class="hero-portrait" style={`
      width: ${headSize2}px; height: ${headSize2}px;
      border-color: ${color2};
      opacity: ${headOpacity2};
    `}>
      {DRIVER_HEADSHOTS[drv2] && <img src={DRIVER_HEADSHOTS[drv2]} alt={drv2} />}
    </div>
    <span class="hero-name" style={`color: ${color2}; opacity: ${headOpacity2}; font-size: ${raceWinner === 2 ? '1.8rem' : raceWinner === 1 ? '1.2rem' : '1.5rem'};`}>{drv2}</span>
    <div class="hero-result">
      <span class="hero-pos" style={`background: ${color2};`}>P{r2.finish}</span>
      <span class={`hero-change ${posChange(r2.grid, r2.finish).cls}`}>
        {posChange(r2.grid, r2.finish).arrow}{posChange(r2.grid, r2.finish).text}
      </span>
    </div>
  </div>
</header>

<SubNav basePath={basePath} current="hub" drv1={drv1} drv2={drv2} />

<!-- ===== スコアカード：全比較を統一フォーマットで ===== -->
<div class="scorecard">

  <!-- ペース -->
  {(() => {
    const [s1, s2] = iconSizes(paceComp.winner, paceComp.intensity);
    const [o1, o2] = opacities(paceComp.winner, paceComp.intensity);
    return (
      <div class="score-row">
        <div class="score-left" style={`opacity: ${o1};`}>
          <svg width={s1} height={s1} viewBox="0 0 24 24" fill={color1} opacity="0.9"><circle cx="12" cy="12" r="10"/></svg>
          <span class="score-val">{pace.drv1.median.toFixed(3)}s</span>
        </div>
        <div class="score-label">
          <span class="score-title">Pace</span>
          <span class="score-sub">median lap</span>
        </div>
        <div class="score-right" style={`opacity: ${o2};`}>
          <span class="score-val">{pace.drv2.median.toFixed(3)}s</span>
          <svg width={s2} height={s2} viewBox="0 0 24 24" fill={color2} opacity="0.9"><circle cx="12" cy="12" r="10"/></svg>
        </div>
      </div>
    );
  })()}

  <!-- セクター -->
  {sectorComps.map(sec => {
    const [s1, s2] = iconSizes(sec.comp.winner, sec.comp.intensity);
    const [o1, o2] = opacities(sec.comp.winner, sec.comp.intensity);
    return (
      <div class="score-row">
        <div class="score-left" style={`opacity: ${o1};`}>
          <svg width={s1} height={s1} viewBox="0 0 24 24" fill={color1} opacity="0.9"><circle cx="12" cy="12" r="10"/></svg>
          <span class="score-val">{sec.d1Wins} wins</span>
        </div>
        <div class="score-label">
          <span class="score-title">{sec.name}</span>
          <span class="score-sub" style={`color: ${sec.delta < 0 ? color1 : color2};`}>
            {sec.delta !== null ? `${sec.delta > 0 ? '+' : ''}${sec.delta.toFixed(3)}s` : ''}
          </span>
        </div>
        <div class="score-right" style={`opacity: ${o2};`}>
          <span class="score-val">{sec.d2Wins} wins</span>
          <svg width={s2} height={s2} viewBox="0 0 24 24" fill={color2} opacity="0.9"><circle cx="12" cy="12" r="10"/></svg>
        </div>
      </div>
    );
  })}

  <!-- スピード -->
  {speedComps.map(sp => {
    const [s1, s2] = iconSizes(sp.comp.winner, sp.comp.intensity);
    const [o1, o2] = opacities(sp.comp.winner, sp.comp.intensity);
    return (
      <div class="score-row">
        <div class="score-left" style={`opacity: ${o1};`}>
          <svg width={s1} height={s1} viewBox="0 0 24 24" fill={color1} opacity="0.9"><circle cx="12" cy="12" r="10"/></svg>
          <span class="score-val">{sp.v1} km/h</span>
        </div>
        <div class="score-label">
          <span class="score-title">{sp.label}</span>
          <span class="score-sub" style={`color: ${sp.delta > 0 ? color1 : color2};`}>
            {sp.delta !== null ? `${sp.delta > 0 ? '+' : ''}${sp.delta} km/h` : ''}
          </span>
        </div>
        <div class="score-right" style={`opacity: ${o2};`}>
          <span class="score-val">{sp.v2} km/h</span>
          <svg width={s2} height={s2} viewBox="0 0 24 24" fill={color2} opacity="0.9"><circle cx="12" cy="12" r="10"/></svg>
        </div>
      </div>
    );
  })}

  <!-- クリーンラップ -->
  {(() => {
    const [s1, s2] = iconSizes(cleanComp.winner, cleanComp.intensity);
    const [o1, o2] = opacities(cleanComp.winner, cleanComp.intensity);
    return (
      <div class="score-row">
        <div class="score-left" style={`opacity: ${o1};`}>
          <svg width={s1} height={s1} viewBox="0 0 24 24" fill={color1} opacity="0.9"><circle cx="12" cy="12" r="10"/></svg>
          <span class="score-val">{pace.drv1.clean_laps}/{pace.drv1.total_laps}</span>
        </div>
        <div class="score-label">
          <span class="score-title">Clean Laps</span>
          <span class="score-sub">{Math.round(cleanPct1 * 100)}% vs {Math.round(cleanPct2 * 100)}%</span>
        </div>
        <div class="score-right" style={`opacity: ${o2};`}>
          <span class="score-val">{pace.drv2.clean_laps}/{pace.drv2.total_laps}</span>
          <svg width={s2} height={s2} viewBox="0 0 24 24" fill={color2} opacity="0.9"><circle cx="12" cy="12" r="10"/></svg>
        </div>
      </div>
    );
  })()}

</div>

<!-- ===== ストラテジータイムライン ===== -->
<div class="strategy-section">
  <h2 class="section-title">Strategy</h2>
  {[
    { drv: drv1, color: color1, stints: analysis.stints.drv1, result: r1 },
    { drv: drv2, color: color2, stints: analysis.stints.drv2, result: r2 },
  ].map(({ drv, color, stints, result }) => (
    <div class="stint-row">
      <span class="stint-drv" style={`color: ${color};`}>{drv}</span>
      <div class="stint-timeline">
        {(stints as any[]).map((s: any) => {
          const widthPct = (s.total_laps / totalLaps) * 100;
          const tyreColor = TYRE_COLORS[s.compound] || '#999';
          return (
            <div
              class="stint-block"
              style={`width: ${widthPct}%; background: ${tyreColor}; color: ${s.compound === 'HARD' ? '#15151e' : '#fff'};`}
              title={`${s.compound} ${s.total_laps}周`}
            >
              <span class="stint-label">{s.compound.charAt(0)}{s.total_laps}</span>
            </div>
          );
        })}
      </div>
    </div>
  ))}
  <div class="stint-axis">
    <span>L1</span>
    <span>L{Math.round(totalLaps / 2)}</span>
    <span>L{totalLaps}</span>
  </div>
</div>

<!-- ===== 詳細分析へ ===== -->
<h2 class="section-title">Detailed Analysis</h2>
<div class="nav-cards">
  {subPages.map(page => (
    <a href={page.href} class="nav-card">
      <div class="nav-card-header">
        <span class="nav-card-icon" set:html={page.icon} />
        <span class="nav-card-title">{page.label}</span>
      </div>
      <div class="nav-card-desc">{page.desc}</div>
      <span class="nav-card-arrow">&rarr;</span>
    </a>
  ))}
</div>

</Base>

<style>
  .breadcrumb { font-size: 0.85rem; color: var(--text-dim); margin-bottom: 24px; display: flex; align-items: center; gap: 6px; }
  .breadcrumb a { color: var(--text-dim); }

  /* ===== ヒーロー ===== */
  .hero {
    display: flex; align-items: center; justify-content: center; gap: 24px;
    margin-bottom: 32px; padding: 24px 0;
  }
  .hero-driver { display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 100px; }
  .hero-portrait {
    border-radius: 50%; overflow: hidden; border: 3px solid;
    background: var(--bg-card); transition: all 0.3s;
  }
  .hero-portrait img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .hero-name { font-weight: 800; transition: all 0.3s; }
  .hero-result { display: flex; align-items: center; gap: 6px; }
  .hero-pos {
    font-size: 0.85rem; font-weight: 900; color: #fff;
    padding: 3px 10px; border-radius: 4px;
  }
  .hero-change { font-size: 0.75rem; font-weight: 700; }
  .pos-up { color: #28973e; }
  .pos-down { color: #ff2d27; }
  .pos-same { color: var(--text-dim); }

  .hero-center { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .hero-vs { font-size: 1.6rem; font-weight: 900; color: var(--text-dim); letter-spacing: 0.1em; }
  .hero-gp { font-size: 0.75rem; color: var(--text-dim); }
  .hero-gp-name { font-size: 0.85rem; color: var(--text-dim); font-weight: 600; }

  /* ===== スコアカード ===== */
  .scorecard {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
    overflow: hidden; margin-bottom: 32px;
  }
  .score-row {
    display: flex; align-items: center; padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }
  .score-row:last-child { border-bottom: none; }
  .score-row:hover { background: var(--bg-card-hover); }

  .score-left {
    flex: 1; display: flex; align-items: center; gap: 10px;
    transition: opacity 0.3s;
  }
  .score-right {
    flex: 1; display: flex; align-items: center; justify-content: flex-end; gap: 10px;
    transition: opacity 0.3s;
  }
  .score-val {
    font-size: 0.85rem; font-family: 'SF Mono', 'Fira Code', monospace;
    color: var(--text);
  }

  .score-label {
    min-width: 100px; text-align: center; display: flex; flex-direction: column; gap: 1px;
  }
  .score-title { font-size: 0.8rem; font-weight: 700; color: var(--text); text-transform: uppercase; letter-spacing: 0.04em; }
  .score-sub { font-size: 0.7rem; font-weight: 600; }

  /* ===== ストラテジー ===== */
  .section-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }

  .strategy-section { margin-bottom: 32px; }
  .stint-row { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
  .stint-drv { font-weight: 700; font-size: 0.85rem; min-width: 36px; text-align: center; }
  .stint-timeline {
    flex: 1; height: 28px; display: flex; border-radius: 4px;
    overflow: hidden; position: relative; gap: 2px;
  }
  .stint-block {
    display: flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 700; border-radius: 3px;
  }
  .stint-label { white-space: nowrap; }
  .stint-axis {
    display: flex; justify-content: space-between; margin-top: 4px; margin-left: 48px;
    font-size: 0.65rem; color: var(--text-dim);
  }

  /* ===== ナビカード ===== */
  .nav-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-bottom: 40px; }
  .nav-card {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px;
    padding: 20px; text-decoration: none; color: var(--text);
    display: flex; flex-direction: column; gap: 8px; position: relative;
    transition: border-color 0.15s, background 0.15s;
  }
  .nav-card:hover { border-color: var(--accent); background: var(--bg-card-hover); text-decoration: none; }
  .nav-card-header { display: flex; align-items: center; gap: 8px; }
  .nav-card-icon { color: var(--accent); display: flex; align-items: center; }
  .nav-card-title { font-size: 1.1rem; font-weight: 700; }
  .nav-card-desc { font-size: 0.85rem; color: var(--text-dim); }
  .nav-card-arrow { position: absolute; top: 20px; right: 20px; color: var(--text-dim); font-size: 1.2rem; }

  /* ===== レスポンシブ ===== */
  @media (max-width: 640px) {
    .hero { gap: 12px; }
    .hero-driver { min-width: 70px; }
    .score-label { min-width: 70px; }
    .score-val { font-size: 0.75rem; }
  }
</style>
