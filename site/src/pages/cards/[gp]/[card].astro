---
import Base from '../../../layouts/Base.astro';
import { listGPsWithCards, loadCardData, CARD_TYPES } from '../../../lib/data';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const gp of listGPsWithCards()) {
    for (const card of CARD_TYPES) {
      const data = loadCardData(gp.dir_name, card);
      if (!data) continue;
      paths.push({
        params: { gp: gp.slug, card },
        props: { data, gpName: gp.gp_name, round: gp.round, year: gp.year },
      });
    }
  }
  return paths;
}

const { gp, card } = Astro.params;
const { data, gpName, round, year } = Astro.props;
const titleMap: Record<string, string> = {
  'lap1-delta': 'LAP 1 POSITION DELTA',
  'tyre-cliff': 'TYRE CLIFF',
  'pace-variance': 'PACE VARIANCE',
  'what-if': 'WHAT IF — PIT LOSS',
  'braking-point': 'BRAKING POINT',
  'corner-speed': 'CORNER SPEED',
  'overtake-replay': 'OVERTAKE REPLAY',
};
const title = titleMap[card as string] || (card as string).toUpperCase();
const subtitle = `${year} · R${String(round).padStart(2, '0')} ${gpName.toUpperCase()}`;
const payload = JSON.stringify(data);
const pending = data.status === 'pending' || (!data.drivers?.length && !data.overtakes?.length && !data.corners?.length && !data.teams?.length && !(Array.isArray(data.data) && data.data.length > 0));
---
<Base title={`${title} — ${subtitle} — Motorsports Visualised`} description={`${title} analysis for ${subtitle}`}>
<div class="card-page">
<div class="card">
  <div class="wm">MOTORSPORTS-VISUALISED</div>
  <div class="ttl">{title}</div>
  <div class="sub">{subtitle}</div>
  <div class="body">
    {pending ? (
      <div class="pending">DATA PENDING — OPENF1 INTEGRATION REQUIRED</div>
    ) : (
      <canvas id="chart" width="968" height="820" role="img" aria-label={`${title} chart for ${subtitle}`}></canvas>
    )}
  </div>
</div>
<script type="application/json" id="payload" set:html={payload}></script>
<script is:inline define:vars={{ cardType: card }}>
(() => {
  const data = JSON.parse(document.getElementById('payload').textContent);
  if (data.status === 'pending') return;
  const canvas = document.getElementById('chart');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const pad = { t: 20, r: 40, b: 60, l: 60 };

  function drawGrid(rows) {
    ctx.strokeStyle = '#0e0e14';
    ctx.lineWidth = 1;
    for (let i = 0; i <= rows; i++) {
      const y = pad.t + (i / rows) * (H - pad.t - pad.b);
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W - pad.r, y); ctx.stroke();
    }
  }

  if (cardType === 'lap1-delta') {
    const rows = data.drivers.slice(0, 20);
    const rowH = (H - pad.t - pad.b) / rows.length;
    const maxD = 8;
    const midX = (pad.l + W - pad.r) / 2;
    ctx.strokeStyle = '#252525'; ctx.beginPath(); ctx.moveTo(midX, pad.t); ctx.lineTo(midX, H - pad.b); ctx.stroke();
    rows.forEach((d, i) => {
      const cy = pad.t + (i + 0.5) * rowH;
      const pct = Math.max(-1, Math.min(1, d.delta / maxD));
      const cx = midX + pct * ((W - pad.r - midX) * 0.9);
      const color = d.delta > 0 ? '#39b54a' : d.delta < 0 ? '#e80020' : '#555';
      ctx.fillStyle = '#e0e0e0'; ctx.font = 'bold 20px "Bebas Neue"'; ctx.textAlign = 'right';
      ctx.fillText(d.code, pad.l + 40, cy + 7);
      ctx.beginPath(); ctx.arc(cx, cy, 14, 0, Math.PI * 2);
      ctx.fillStyle = color + '33'; ctx.fill();
      ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.stroke();
      ctx.fillStyle = color; ctx.font = 'bold 13px "IBM Plex Mono"';
      ctx.textAlign = d.delta >= 0 ? 'left' : 'right';
      ctx.fillText((d.delta > 0 ? '+' : '') + d.delta, cx + (d.delta >= 0 ? 20 : -20), cy + 5);
    });
  }

  if (cardType === 'tyre-cliff') {
    const drivers = data.drivers.slice(0, 8);
    if (!drivers.length) return;
    const allTimes = drivers.flatMap(d => d.times);
    const minT = Math.min(...allTimes), maxT = Math.max(...allTimes);
    const maxLaps = Math.max(...drivers.map(d => d.laps.length));
    drawGrid(6);
    const palette = ['#E07800','#DC0000','#2B5DAB','#00B89F','#1B7A5A','#3BA3E0','#4A72CC','#0078AA'];
    drivers.forEach((d, i) => {
      const c = palette[i % palette.length];
      ctx.strokeStyle = c; ctx.lineWidth = 2; ctx.beginPath();
      d.ma.forEach((t, j) => {
        const x = pad.l + (j / Math.max(1, maxLaps - 1)) * (W - pad.l - pad.r);
        const y = pad.t + ((t - minT) / (maxT - minT)) * (H - pad.t - pad.b);
        if (j === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.fillStyle = c; ctx.font = '11px "IBM Plex Mono"'; ctx.textAlign = 'left';
      ctx.fillText(d.code, W - pad.r + 5, pad.t + 15 + i * 14);
    });
  }

  if (cardType === 'pace-variance') {
    const teams = data.teams;
    const maxStd = Math.max(...teams.map(t => t.stdev)) || 1;
    const barH = (H - pad.t - pad.b) / teams.length * 0.75;
    teams.forEach((t, i) => {
      const y = pad.t + i * ((H - pad.t - pad.b) / teams.length);
      const len = (t.stdev / maxStd) * (W - pad.l - pad.r - 200);
      ctx.fillStyle = t.color;
      ctx.fillRect(pad.l + 160, y + 5, len, barH);
      ctx.fillStyle = '#e0e0e0'; ctx.font = 'bold 14px "IBM Plex Mono"'; ctx.textAlign = 'right';
      ctx.fillText(t.team.toUpperCase(), pad.l + 150, y + barH - 2);
      ctx.fillStyle = '#888'; ctx.font = '11px "IBM Plex Mono"'; ctx.textAlign = 'left';
      ctx.fillText('σ=' + t.stdev.toFixed(3) + 's  med=' + t.median.toFixed(2), pad.l + 160 + len + 8, y + barH - 2);
    });
  }

  // サーキット形状正規化ヘルパー: outline配列を canvas座標に変換
  function fitOutline(outline, targetW, targetH, marginX, marginY) {
    if (!outline || !outline.length) return null;
    const xs = outline.map(p => p.x).filter(v => v != null);
    const ys = outline.map(p => p.y).filter(v => v != null);
    if (!xs.length || !ys.length) return null;
    const minX = Math.min(...xs), maxX = Math.max(...xs);
    const minY = Math.min(...ys), maxY = Math.max(...ys);
    const rx = (targetW - marginX * 2) / Math.max(1, maxX - minX);
    const ry = (targetH - marginY * 2) / Math.max(1, maxY - minY);
    const r = Math.min(rx, ry);
    const ox = marginX + ((targetW - marginX * 2) - (maxX - minX) * r) / 2;
    const oy = marginY + ((targetH - marginY * 2) - (maxY - minY) * r) / 2;
    return { project: (x, y) => [ox + (x - minX) * r, oy + (maxY - y) * r], minX, maxX, minY, maxY, r };
  }

  if (cardType === 'braking-point') {
    const proj = fitOutline(data.outline, W, H - pad.b, 40, 40);
    if (!proj) return;
    // outline
    ctx.strokeStyle = '#252525'; ctx.lineWidth = 2; ctx.beginPath();
    data.outline.forEach((p, i) => {
      if (p.x == null || p.y == null) return;
      const [px, py] = proj.project(p.x, p.y);
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    });
    ctx.stroke();
    // corners
    data.corners.forEach(c => {
      if (c.x == null || c.y == null) return;
      const [px, py] = proj.project(c.x, c.y);
      ctx.fillStyle = '#444'; ctx.beginPath(); ctx.arc(px, py, 4, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#666'; ctx.font = '10px "IBM Plex Mono"'; ctx.textAlign = 'center';
      ctx.fillText(c.name_approx, px, py - 8);
    });
    // braking dots per driver (角度方向にオフセットして重なりを解消)
    const driverCount = data.drivers.length;
    data.drivers.forEach((d, di) => {
      const angleOffset = (di / Math.max(1, driverCount)) * Math.PI * 2;
      (d.braking_points || []).forEach(bp => {
        const c = data.corners.find(cc => cc.id === bp.corner_id);
        if (!c || c.x == null) return;
        const [px, py] = proj.project(c.x, c.y);
        // ブレーキが早いほどコーナーから遠い距離に配置
        const dist = 12 + (bp.time_to_apex_s || 0) * 10;
        const dotX = px + Math.cos(angleOffset) * dist;
        const dotY = py + Math.sin(angleOffset) * dist;
        ctx.fillStyle = d.color;
        ctx.beginPath(); ctx.arc(dotX, dotY, 5, 0, Math.PI * 2); ctx.fill();
      });
    });
    // legend (top drivers)
    data.drivers.slice(0, 10).forEach((d, i) => {
      const y = pad.t + 10 + i * 16;
      ctx.fillStyle = d.color; ctx.fillRect(W - pad.r - 64, y, 10, 10);
      ctx.fillStyle = '#aaa'; ctx.font = '11px "IBM Plex Mono"'; ctx.textAlign = 'left';
      ctx.fillText(d.code, W - pad.r - 50, y + 9);
    });
  }

  if (cardType === 'corner-speed') {
    // レーダーチャート: コーナーを角度、最低速度を半径
    const cornerLabels = data.corners || [];
    const N = cornerLabels.length;
    if (N === 0) return;
    const cx = W / 2, cy = H / 2 - 10;
    const R = Math.min(W, H - pad.t - pad.b) / 2 - 60;
    // gather all speed values for scaling
    const all = data.drivers.flatMap(d => (d.min_speeds || []).filter(v => v != null));
    if (!all.length) return;
    const maxV = Math.max(...all), minV = Math.max(0, Math.min(...all) - 20);
    // grid rings
    ctx.strokeStyle = '#1a1a1a';
    for (let ring = 1; ring <= 4; ring++) {
      ctx.beginPath();
      ctx.arc(cx, cy, (R * ring) / 4, 0, Math.PI * 2);
      ctx.stroke();
    }
    // axis lines + labels
    for (let i = 0; i < N; i++) {
      const ang = (i / N) * Math.PI * 2 - Math.PI / 2;
      const lx = cx + Math.cos(ang) * R, ly = cy + Math.sin(ang) * R;
      ctx.strokeStyle = '#151515';
      ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(lx, ly); ctx.stroke();
      ctx.fillStyle = '#555'; ctx.font = '10px "IBM Plex Mono"'; ctx.textAlign = 'center';
      ctx.fillText(cornerLabels[i], cx + Math.cos(ang) * (R + 14), cy + Math.sin(ang) * (R + 14) + 4);
    }
    // polygons per driver (top 5)
    // Legend at the top of the card body (above chart)
    data.drivers.slice(0, 5).forEach((d, di) => {
      const lx = pad.l + di * 160;
      const ly = pad.t;
      ctx.fillStyle = d.color; ctx.fillRect(lx, ly, 12, 12);
      ctx.fillStyle = '#aaa'; ctx.font = '12px "IBM Plex Mono"'; ctx.textAlign = 'left';
      ctx.fillText(d.code + ' ' + (d.team || ''), lx + 18, ly + 11);
    });
    ctx.fillStyle = '#444'; ctx.font = '10px "IBM Plex Mono"'; ctx.textAlign = 'left';
    ctx.fillText('apex km/h ' + Math.round(minV) + '–' + Math.round(maxV), pad.l, pad.t + 24);

    // Polygons per driver (top 5)
    data.drivers.slice(0, 5).forEach((d, di) => {
      ctx.strokeStyle = d.color; ctx.lineWidth = 2;
      ctx.beginPath();
      let started = false;
      for (let i = 0; i < N; i++) {
        const v = (d.min_speeds || [])[i];
        if (v == null) continue;
        const ang = (i / N) * Math.PI * 2 - Math.PI / 2;
        const r = ((v - minV) / Math.max(1, maxV - minV)) * R;
        const px = cx + Math.cos(ang) * r, py = cy + Math.sin(ang) * r;
        if (!started) { ctx.moveTo(px, py); started = true; } else { ctx.lineTo(px, py); }
      }
      ctx.closePath();
      // 半透明fillはglobalAlphaで制御（hex alpha付加より安全）
      ctx.globalAlpha = 0.08;
      ctx.fillStyle = d.color;
      ctx.fill();
      ctx.globalAlpha = 1.0;
      ctx.stroke();
    });
  }

  if (cardType === 'overtake-replay') {
    const proj = fitOutline(data.outline, W, H - pad.b - 60, 40, 40);
    if (!proj) return;
    // outline
    ctx.strokeStyle = '#252525'; ctx.lineWidth = 2; ctx.beginPath();
    data.outline.forEach((p, i) => {
      if (p.x == null || p.y == null) return;
      const [px, py] = proj.project(p.x, p.y);
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    });
    ctx.stroke();

    (data.overtakes || []).slice(0, 3).forEach((ot, i) => {
      // attacker trace
      ctx.strokeStyle = ot.attacker.color; ctx.lineWidth = 3;
      ctx.beginPath();
      (ot.attacker.trace || []).forEach((p, j) => {
        if (p.x == null || p.y == null) return;
        const [px, py] = proj.project(p.x, p.y);
        if (j === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      });
      ctx.stroke();
      // defender trace (dashed)
      ctx.strokeStyle = ot.defender.color; ctx.lineWidth = 2;
      ctx.setLineDash([6, 4]);
      ctx.beginPath();
      (ot.defender.trace || []).forEach((p, j) => {
        if (p.x == null || p.y == null) return;
        const [px, py] = proj.project(p.x, p.y);
        if (j === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      });
      ctx.stroke();
      ctx.setLineDash([]);
      // final dots
      const aLast = (ot.attacker.trace || []).slice(-1)[0];
      const dLast = (ot.defender.trace || []).slice(-1)[0];
      if (aLast && aLast.x != null) {
        const [px, py] = proj.project(aLast.x, aLast.y);
        ctx.fillStyle = ot.attacker.color; ctx.beginPath(); ctx.arc(px, py, 7, 0, Math.PI * 2); ctx.fill();
      }
      if (dLast && dLast.x != null) {
        const [px, py] = proj.project(dLast.x, dLast.y);
        ctx.fillStyle = ot.defender.color; ctx.beginPath(); ctx.arc(px, py, 7, 0, Math.PI * 2); ctx.fill();
      }
    });
    // list
    (data.overtakes || []).slice(0, 3).forEach((ot, i) => {
      const y = H - pad.b - 40 + i * 16;
      ctx.fillStyle = ot.attacker.color; ctx.font = 'bold 13px "IBM Plex Mono"'; ctx.textAlign = 'left';
      ctx.fillText(ot.attacker.code, pad.l, y);
      ctx.fillStyle = '#666'; ctx.fillText('>', pad.l + 48, y);
      ctx.fillStyle = ot.defender.color; ctx.fillText(ot.defender.code, pad.l + 64, y);
      ctx.fillStyle = '#888'; ctx.fillText('→ P' + ot.new_pos, pad.l + 120, y);
    });
  }

  if (cardType === 'what-if') {
    const drivers = data.drivers.slice(0, 12);
    const maxLoss = Math.max(...drivers.map(d => d.pit_loss_sum)) || 1;
    const barH = (H - pad.t - pad.b) / drivers.length * 0.7;
    drivers.forEach((d, i) => {
      const y = pad.t + i * ((H - pad.t - pad.b) / drivers.length);
      const len = (d.pit_loss_sum / maxLoss) * (W - pad.l - pad.r - 160);
      ctx.fillStyle = '#4A72CC';
      ctx.fillRect(pad.l + 100, y + 5, len, barH);
      ctx.fillStyle = '#e0e0e0'; ctx.font = 'bold 20px "Bebas Neue"'; ctx.textAlign = 'right';
      ctx.fillText(d.code, pad.l + 90, y + barH + 2);
      ctx.fillStyle = '#888'; ctx.font = '12px "IBM Plex Mono"'; ctx.textAlign = 'left';
      ctx.fillText('+' + d.pit_loss_sum.toFixed(1) + 's', pad.l + 100 + len + 8, y + barH + 2);
    });
  }
})();
</script>
</div>
</Base>

<style>
  .card-page {
    display: flex;
    justify-content: center;
    padding: 20px 0;
  }
  .card{width:1080px;height:1080px;background:#060606;position:relative;overflow:hidden;padding:48px 56px}
  .wm{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.15em;color:#181818;position:absolute;top:28px;right:56px;text-transform:uppercase}
  .ttl{font-family:'Bebas Neue',sans-serif;font-size:56px;letter-spacing:0.06em;color:#e0e0e0;line-height:1}
  .sub{font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.18em;color:#6a6a6a;text-transform:uppercase;margin-top:6px}
  .body{margin-top:36px}
  .pending{display:flex;align-items:center;justify-content:center;height:820px;border:1px dashed #252525;color:#4a4a4a;font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:0.1em}
  canvas{display:block}
  table{width:100%;border-collapse:collapse;font-size:14px}
  td{padding:8px 10px;border-bottom:1px solid #111}
  .code{font-family:'Bebas Neue',sans-serif;font-size:22px}
  .pos{color:#39b54a;font-weight:600}
  .neg{color:#e80020;font-weight:600}
</style>
                                                                                                                                                                                                                                                                                                                                        