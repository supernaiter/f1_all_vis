---
import Base from '../../layouts/Base.astro';
import { listGPs, loadH2HIndex, loadH2HAnalysis, getChartUrl, TEAM_COLORS } from '../../lib/data';

export function getStaticPaths() {
  const gps = listGPs();
  const paths: any[] = [];

  for (const gp of gps) {
    const index = loadH2HIndex(gp.dir_name);
    if (!index) continue;

    for (const pair of index.pairs) {
      const slug = `${gp.year}-r${String(gp.round).padStart(2, '0')}-${gp.gp_name.toLowerCase()}/${pair.driver1.toLowerCase()}-vs-${pair.driver2.toLowerCase()}`;
      paths.push({
        params: { slug },
        props: {
          dirName: gp.dir_name,
          pairDir: pair.path,
          gpMeta: index.meta,
        },
      });
    }
  }

  return paths;
}

const { dirName, pairDir, gpMeta } = Astro.props;
const analysis = loadH2HAnalysis(dirName, pairDir);

if (!analysis) {
  return Astro.redirect('/');
}

const { meta, race_result, pace, sectors, speed, stints, seo } = analysis;
const drv1 = meta.driver1;
const drv2 = meta.driver2;
const color1 = TEAM_COLORS[meta.team1] || '#999';
const color2 = TEAM_COLORS[meta.team2] || '#999';

// チャート画像のURLパスを取得（PNGはpublic/charts/にコピー済み）
const charts = {
  laptime: getChartUrl(dirName, pairDir, 'chart_laptime_delta.png'),
  speed: getChartUrl(dirName, pairDir, 'chart_speed_boxplot.png'),
  sector: getChartUrl(dirName, pairDir, 'chart_sector_compare.png'),
  sectorTable: getChartUrl(dirName, pairDir, 'chart_sector_table.png'),
};

const r1 = race_result[drv1];
const r2 = race_result[drv2];

// SEO構造化データ
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: seo.title,
  description: seo.description,
  keywords: seo.keywords.join(', '),
};
---

<Base title={seo.title_ja} description={seo.description} keywords={seo.keywords}>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<nav class="breadcrumb">
  <a href="/">Home</a> &rsaquo;
  <a href="/">R{String(meta.round).padStart(2, '0')} {meta.gp_name}</a> &rsaquo;
  <span>{drv1} vs {drv2}</span>
</nav>

<header class="page-header">
  <h1>
    <span class="drv-name" style={`color: ${color1};`}>{drv1}</span>
    <span class="vs-text">vs</span>
    <span class="drv-name" style={`color: ${color2};`}>{drv2}</span>
  </h1>
  <p class="page-subtitle">{meta.year} R{String(meta.round).padStart(2, '0')} {meta.gp_name} GP &mdash; Race Pace Comparison</p>
</header>

<!-- サマリーカード -->
<div class="summary-grid">
  <div class="summary-card">
    <div class="card-label">Race Result</div>
    <div class="card-row">
      <span class="drv-tag" style={`border-color: ${color1};`}>{drv1}</span>
      <span>P{r1.finish} (Grid P{r1.grid})</span>
    </div>
    <div class="card-row">
      <span class="drv-tag" style={`border-color: ${color2};`}>{drv2}</span>
      <span>P{r2.finish} (Grid P{r2.grid})</span>
    </div>
  </div>

  <div class="summary-card">
    <div class="card-label">Pace Delta</div>
    {pace.delta_median_sec !== null && (
      <div class="delta-big" style={`color: ${pace.faster === drv1 ? color1 : color2};`}>
        {pace.delta_median_sec > 0 ? '+' : ''}{pace.delta_median_sec.toFixed(3)}s/lap
      </div>
    )}
    <div class="card-note">{pace.faster} faster (median)</div>
  </div>

  <div class="summary-card">
    <div class="card-label">Clean Laps</div>
    <div class="card-row">
      <span class="drv-tag" style={`border-color: ${color1};`}>{drv1}</span>
      <span>{pace.drv1.clean_laps} / {pace.drv1.total_laps}</span>
    </div>
    <div class="card-row">
      <span class="drv-tag" style={`border-color: ${color2};`}>{drv2}</span>
      <span>{pace.drv2.clean_laps} / {pace.drv2.total_laps}</span>
    </div>
  </div>

  <div class="summary-card">
    <div class="card-label">Strategy</div>
    <div class="card-row">
      <span class="drv-tag" style={`border-color: ${color1};`}>{drv1}</span>
      <span>Pit: L{r1.pit_laps.join(', L')}</span>
    </div>
    <div class="card-row">
      <span class="drv-tag" style={`border-color: ${color2};`}>{drv2}</span>
      <span>Pit: L{r2.pit_laps.join(', L')}</span>
    </div>
  </div>
</div>

<!-- セクターサマリー -->
<section class="chart-section">
  <h2>Sector Analysis</h2>
  <div class="sector-grid">
    {Object.entries(sectors).map(([secName, data]: [string, any]) => (
      <div class="sector-card">
        <div class="sec-name">{secName}</div>
        <div class="sec-delta" style={`color: ${(data.delta_sec ?? 0) < 0 ? color1 : color2};`}>
          {data.delta_sec !== null ? `${data.delta_sec > 0 ? '+' : ''}${data.delta_sec.toFixed(3)}s` : '-'}
        </div>
        <div class="sec-wins">
          <span style={`color: ${color1};`}>{data[`${drv1}_wins`]}</span>
          <span class="sec-wins-sep">-</span>
          <span style={`color: ${color2};`}>{data[`${drv2}_wins`]}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- スピードサマリー -->
<section class="chart-section">
  <h2>Speed Comparison</h2>
  <div class="speed-table">
    <table>
      <thead>
        <tr>
          <th>Measurement</th>
          <th style={`color: ${color1};`}>{drv1}</th>
          <th style={`color: ${color2};`}>{drv2}</th>
          <th>Delta</th>
        </tr>
      </thead>
      <tbody>
        {Object.entries(speed).map(([label, data]: [string, any]) => (
          <tr>
            <td>{label}</td>
            <td>{data[`${drv1}_median`] ?? '-'} km/h</td>
            <td>{data[`${drv2}_median`] ?? '-'} km/h</td>
            <td class={data.delta_kmh > 0 ? 'delta-pos' : 'delta-neg'}>
              {data.delta_kmh !== null ? `${data.delta_kmh > 0 ? '+' : ''}${data.delta_kmh}` : '-'}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<!-- チャート -->
<section class="chart-section">
  <h2>Lap Time & Delta</h2>
  {charts.laptime && <img src={charts.laptime} alt={`${drv1} vs ${drv2} lap times`} class="chart-img" loading="lazy" />}
</section>

<section class="chart-section">
  <h2>Speed Distribution</h2>
  {charts.speed && <img src={charts.speed} alt={`${drv1} vs ${drv2} speed boxplot`} class="chart-img" loading="lazy" />}
</section>

<section class="chart-section">
  <h2>Sector Comparison</h2>
  {charts.sectorTable && <img src={charts.sectorTable} alt={`${drv1} vs ${drv2} sector table`} class="chart-img" loading="lazy" />}
  {charts.sector && <img src={charts.sector} alt={`${drv1} vs ${drv2} sector compare`} class="chart-img" loading="lazy" />}
</section>

</Base>

<style>
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 24px;
  }

  .page-header { margin-bottom: 32px; }

  .page-header h1 {
    font-size: 2.4rem;
    font-weight: 800;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .vs-text { color: var(--text-dim); font-size: 1.2rem; font-weight: 400; }
  .page-subtitle { color: var(--text-dim); font-size: 1rem; margin-top: 4px; }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .summary-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .card-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .card-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
    font-size: 0.95rem;
  }

  .drv-tag {
    font-weight: 700;
    border-left: 3px solid;
    padding-left: 8px;
  }

  .delta-big {
    font-size: 1.8rem;
    font-weight: 800;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  .card-note { font-size: 0.85rem; color: var(--text-dim); margin-top: 4px; }

  .chart-section {
    margin-bottom: 48px;
  }

  .chart-section h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .chart-img {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 16px;
  }

  .sector-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .sector-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    text-align: center;
  }

  .sec-name {
    font-size: 0.85rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .sec-delta {
    font-size: 1.6rem;
    font-weight: 800;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  .sec-wins {
    margin-top: 8px;
    font-size: 1rem;
    font-weight: 600;
  }

  .sec-wins-sep { color: var(--text-dim); margin: 0 4px; }

  .speed-table { overflow-x: auto; }

  .speed-table table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-card);
    border-radius: 8px;
    overflow: hidden;
  }

  .speed-table th, .speed-table td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .speed-table th {
    background: #1a1a30;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }

  .delta-pos { color: var(--accent); }
  .delta-neg { color: var(--accent-2); }
</style>
