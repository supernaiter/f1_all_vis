---
import Base from '../../../layouts/Base.astro';
import SubNav from '../../../components/SubNav.astro';
import { getH2HStaticPaths, loadH2HAnalysis, TEAM_COLORS, DRIVER_HEADSHOTS } from '../../../lib/data';
import { hubPaceOneLiner, hubSectorOneLiner, hubSpeedOneLiner, hubStintOneLiner } from '../../../lib/insights';

export function getStaticPaths() { return getH2HStaticPaths(); }

const { dirName, pairDir, gpMeta } = Astro.props;
const analysis = loadH2HAnalysis(dirName, pairDir);
if (!analysis) return Astro.redirect('/');

const { meta, race_result, pace, sectors, speed, seo } = analysis;
const drv1 = meta.driver1;
const drv2 = meta.driver2;
const color1 = TEAM_COLORS[meta.team1] || '#999';
const color2 = TEAM_COLORS[meta.team2] || '#999';
const r1 = race_result[drv1];
const r2 = race_result[drv2];
const totalLaps = meta.total_laps;
const basePath = `/h2h/${meta.year}-r${String(meta.round).padStart(2, '0')}-${meta.gp_name.toLowerCase()}/${drv1.toLowerCase()}-vs-${drv2.toLowerCase()}/`;

// ポジション変動
function posChange(grid: number, finish: number) {
  const diff = grid - finish;
  if (diff > 0) return { arrow: '▲', cls: 'pos-up', text: `+${diff}` };
  if (diff < 0) return { arrow: '▼', cls: 'pos-down', text: `${diff}` };
  return { arrow: '—', cls: 'pos-same', text: '±0' };
}
const r1c = posChange(r1.grid, r1.finish);
const r2c = posChange(r2.grid, r2.finish);

// ペースデルタバー計算（0.5秒を最大幅とする）
const absDelta = Math.abs(pace.delta_median_sec ?? 0);
const deltaBarPct = Math.min((absDelta / 0.5) * 50, 50);
const d1Faster = pace.faster === drv1;

// タイヤカラー
const TYRE_COLORS: Record<string, string> = {
  SOFT: '#FF3333', MEDIUM: '#FFD700', HARD: '#FFFFFF',
  INTERMEDIATE: '#39B54A', WET: '#0072CE',
};

// スピード：最大値基準でバー幅を計算
const speedEntries = Object.entries(speed) as [string, any][];
const allSpeeds = speedEntries.flatMap(([, d]) => [d[`${drv1}_median`], d[`${drv2}_median`]]).filter(Boolean);
const maxSpeed = Math.max(...allSpeeds);
const minSpeed = Math.min(...allSpeeds) - 10;

// ナビカードアイコン
const navIcons: Record<string, string> = {
  Pace: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  Sectors: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20"/><line x1="12" y1="2" x2="12" y2="12"/><line x1="12" y1="12" x2="22" y2="12"/></svg>`,
  Speed: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  Stints: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1.5" fill="currentColor"/><circle cx="4" cy="12" r="1.5" fill="currentColor"/><circle cx="4" cy="18" r="1.5" fill="currentColor"/></svg>`,
};
const subPages = [
  { href: `${basePath}pace/`, label: 'Pace', desc: hubPaceOneLiner(analysis), icon: navIcons.Pace },
  { href: `${basePath}sectors/`, label: 'Sectors', desc: hubSectorOneLiner(analysis), icon: navIcons.Sectors },
  { href: `${basePath}speed/`, label: 'Speed', desc: hubSpeedOneLiner(analysis), icon: navIcons.Speed },
  { href: `${basePath}stints/`, label: 'Stints', desc: hubStintOneLiner(analysis), icon: navIcons.Stints },
];

const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: seo.title, description: seo.description, keywords: seo.keywords.join(', ') };
---

<Base title={seo.title_ja} description={seo.description} keywords={seo.keywords}>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<nav class="breadcrumb">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
  <a href="/">Home</a> &rsaquo;
  <a href="/">R{String(meta.round).padStart(2, '0')} {meta.gp_name}</a> &rsaquo;
  <span>{drv1} vs {drv2}</span>
</nav>

<!-- ===== ヘッダー：顔写真 + 名前 ===== -->
<header class="page-header">
  <div class="matchup">
    <div class="matchup-driver">
      <div class="driver-portrait" style={`border-color: ${color1};`}>
        {DRIVER_HEADSHOTS[drv1] && <img src={DRIVER_HEADSHOTS[drv1]} alt={drv1} loading="eager" />}
      </div>
      <span class="drv-name" style={`color: ${color1};`}>{drv1}</span>
    </div>
    <span class="vs-text">VS</span>
    <div class="matchup-driver">
      <div class="driver-portrait" style={`border-color: ${color2};`}>
        {DRIVER_HEADSHOTS[drv2] && <img src={DRIVER_HEADSHOTS[drv2]} alt={drv2} loading="eager" />}
      </div>
      <span class="drv-name" style={`color: ${color2};`}>{drv2}</span>
    </div>
  </div>
  <p class="page-subtitle">{meta.year} R{String(meta.round).padStart(2, '0')} {meta.gp_name} GP</p>
</header>

<SubNav basePath={basePath} current="hub" drv1={drv1} drv2={drv2} />

<!-- ===== レースリザルト ===== -->
<div class="result-banner">
  <div class="result-driver">
    <div class="result-pos" style={`background: ${color1};`}>P{r1.finish}</div>
    <div class="result-meta">
      <span class="result-name" style={`color: ${color1};`}>{drv1}</span>
      <span class="result-grid">Grid P{r1.grid} <span class={r1c.cls}>{r1c.arrow}{r1c.text}</span></span>
    </div>
  </div>
  <div class="result-driver">
    <div class="result-pos" style={`background: ${color2};`}>P{r2.finish}</div>
    <div class="result-meta">
      <span class="result-name" style={`color: ${color2};`}>{drv2}</span>
      <span class="result-grid">Grid P{r2.grid} <span class={r2c.cls}>{r2c.arrow}{r2c.text}</span></span>
    </div>
  </div>
</div>

<!-- ===== ペースデルタ（視覚バー） ===== -->
<div class="delta-section">
  <div class="section-label">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    Pace Delta (median)
  </div>
  <div class="delta-visual">
    <span class="delta-drv" style={`color: ${color1};`}>{drv1}</span>
    <div class="delta-bar-container">
      <div class="delta-bar-track">
        <div class="delta-center-line"></div>
        {d1Faster ? (
          <div class="delta-bar-fill delta-bar-left" style={`width: ${deltaBarPct}%; background: ${color1}; right: 50%;`}></div>
        ) : (
          <div class="delta-bar-fill delta-bar-right" style={`width: ${deltaBarPct}%; background: ${color2}; left: 50%;`}></div>
        )}
      </div>
      <div class="delta-value" style={`color: ${d1Faster ? color1 : color2};`}>
        {absDelta.toFixed(3)}s/lap
      </div>
    </div>
    <span class="delta-drv" style={`color: ${color2};`}>{drv2}</span>
  </div>
</div>

<!-- ===== ストラテジー（タイヤタイムライン） ===== -->
<div class="strategy-section">
  <div class="section-label">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    Strategy
  </div>
  {[
    { drv: drv1, color: color1, stints: analysis.stints.drv1, result: r1 },
    { drv: drv2, color: color2, stints: analysis.stints.drv2, result: r2 },
  ].map(({ drv, color, stints, result }) => (
    <div class="stint-row">
      <span class="stint-drv" style={`color: ${color};`}>{drv}</span>
      <div class="stint-timeline">
        {(stints as any[]).map((s: any) => {
          const widthPct = (s.total_laps / totalLaps) * 100;
          const tyreColor = TYRE_COLORS[s.compound] || '#999';
          return (
            <div
              class="stint-block"
              style={`width: ${widthPct}%; background: ${tyreColor}; color: ${s.compound === 'HARD' ? '#15151e' : '#fff'};`}
              title={`${s.compound} ${s.total_laps}周`}
            >
              <span class="stint-label">{s.compound.charAt(0)}{s.total_laps}</span>
            </div>
          );
        })}
        {result.pit_laps.map((lap: number) => (
          <div class="pit-marker" style={`left: ${(lap / totalLaps) * 100}%;`} title={`Pit L${lap}`}>
            <div class="pit-line"></div>
          </div>
        ))}
      </div>
    </div>
  ))}
  <div class="stint-axis">
    <span>L1</span>
    <span>L{Math.round(totalLaps / 2)}</span>
    <span>L{totalLaps}</span>
  </div>
</div>

<!-- ===== セクター比較 ===== -->
<h2 class="section-title">Sectors</h2>
<div class="sector-grid">
  {Object.entries(sectors).map(([secName, data]: [string, any]) => {
    const d1Wins = data[`${drv1}_wins`] ?? 0;
    const d2Wins = data[`${drv2}_wins`] ?? 0;
    const total = d1Wins + d2Wins;
    const d1Pct = total > 0 ? (d1Wins / total) * 100 : 50;
    const delta = data.delta_sec ?? 0;
    const winner = delta < 0 ? drv1 : drv2;
    const winColor = delta < 0 ? color1 : color2;
    // デルタバー（中央ゼロ、最大0.2秒で50%幅）
    const secBarPct = Math.min((Math.abs(delta) / 0.2) * 50, 50);
    return (
      <div class="sector-card">
        <div class="sec-header">
          <span class="sec-name">{secName}</span>
          <span class="sec-winner" style={`color: ${winColor};`}>{winner}</span>
        </div>
        <div class="sec-delta-bar">
          <div class="sec-delta-track">
            <div class="sec-delta-center"></div>
            {delta < 0 ? (
              <div class="sec-delta-fill" style={`width: ${secBarPct}%; background: ${color1}; right: 50%;`}></div>
            ) : (
              <div class="sec-delta-fill" style={`width: ${secBarPct}%; background: ${color2}; left: 50%;`}></div>
            )}
          </div>
        </div>
        <div class="sec-delta-num" style={`color: ${winColor};`}>
          {delta !== null ? `${delta > 0 ? '+' : ''}${delta.toFixed(3)}s` : '-'}
        </div>
        <div class="sec-wins-bar">
          <div class="sec-bar-d1" style={`width: ${d1Pct}%; background: ${color1};`}></div>
          <div class="sec-bar-d2" style={`width: ${100 - d1Pct}%; background: ${color2};`}></div>
        </div>
        <div class="sec-wins-labels">
          <span style={`color: ${color1};`}>{d1Wins} wins</span>
          <span style={`color: ${color2};`}>{d2Wins} wins</span>
        </div>
      </div>
    );
  })}
</div>

<!-- ===== スピード比較（バーチャート） ===== -->
<h2 class="section-title">Speed</h2>
<div class="speed-bars">
  {speedEntries.map(([label, data]) => {
    const v1 = data[`${drv1}_median`];
    const v2 = data[`${drv2}_median`];
    if (v1 == null || v2 == null) return null;
    const range = maxSpeed - minSpeed;
    const w1 = ((v1 - minSpeed) / range) * 100;
    const w2 = ((v2 - minSpeed) / range) * 100;
    const delta = data.delta_kmh;
    const winColor = delta > 0 ? color1 : color2;
    return (
      <div class="speed-row">
        <div class="speed-label">{label}</div>
        <div class="speed-pair">
          <div class="speed-bar-row">
            <span class="speed-drv" style={`color: ${color1};`}>{drv1}</span>
            <div class="speed-bar-wrap">
              <div class="speed-bar-fill" style={`width: ${w1}%; background: ${color1};`}></div>
            </div>
            <span class="speed-val">{v1}</span>
          </div>
          <div class="speed-bar-row">
            <span class="speed-drv" style={`color: ${color2};`}>{drv2}</span>
            <div class="speed-bar-wrap">
              <div class="speed-bar-fill" style={`width: ${w2}%; background: ${color2};`}></div>
            </div>
            <span class="speed-val">{v2}</span>
          </div>
        </div>
        <div class="speed-delta-badge" style={`color: ${winColor};`}>
          {delta > 0 ? '◀' : '▶'} {Math.abs(delta)} km/h
        </div>
      </div>
    );
  })}
</div>

<!-- ===== 詳細分析へ ===== -->
<h2 class="section-title">Detailed Analysis</h2>
<div class="nav-cards">
  {subPages.map(page => (
    <a href={page.href} class="nav-card">
      <div class="nav-card-header">
        <span class="nav-card-icon" set:html={page.icon} />
        <span class="nav-card-title">{page.label}</span>
      </div>
      <div class="nav-card-desc">{page.desc}</div>
      <span class="nav-card-arrow">&rarr;</span>
    </a>
  ))}
</div>

</Base>

<style>
  /* ===== レイアウト共通 ===== */
  .breadcrumb { font-size: 0.85rem; color: var(--text-dim); margin-bottom: 24px; display: flex; align-items: center; gap: 6px; }
  .breadcrumb a { color: var(--text-dim); }

  .section-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-dim); margin-bottom: 12px; display: flex; align-items: center; gap: 6px; }
  .section-title { font-size: 1.3rem; font-weight: 700; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }

  /* ===== ヘッダー ===== */
  .page-header { margin-bottom: 32px; }
  .matchup { display: flex; align-items: center; justify-content: center; gap: 32px; margin-bottom: 8px; }
  .matchup-driver { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .driver-portrait {
    width: 80px; height: 80px; border-radius: 50%; overflow: hidden;
    border: 3px solid; background: var(--bg-card);
    display: flex; align-items: flex-end; justify-content: center;
  }
  .driver-portrait img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .drv-name { font-size: 1.6rem; font-weight: 800; }
  .vs-text { color: var(--text-dim); font-size: 1.4rem; font-weight: 800; letter-spacing: 0.05em; }
  .page-subtitle { color: var(--text-dim); font-size: 1rem; text-align: center; }

  /* ===== レースリザルトバナー ===== */
  .result-banner {
    display: flex; gap: 16px; margin-bottom: 24px;
  }
  .result-driver {
    flex: 1; display: flex; align-items: center; gap: 12px;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 16px;
  }
  .result-pos {
    font-size: 1.6rem; font-weight: 900; color: #fff;
    width: 56px; height: 56px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .result-meta { display: flex; flex-direction: column; gap: 2px; }
  .result-name { font-weight: 700; font-size: 1.1rem; }
  .result-grid { font-size: 0.8rem; color: var(--text-dim); display: flex; align-items: center; gap: 6px; }
  .pos-up { color: #28973e; font-weight: 700; }
  .pos-down { color: #ff2d27; font-weight: 700; }
  .pos-same { color: var(--text-dim); }

  /* ===== ペースデルタ視覚バー ===== */
  .delta-section {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px;
    padding: 20px; margin-bottom: 24px;
  }
  .delta-visual {
    display: flex; align-items: center; gap: 12px;
  }
  .delta-drv { font-weight: 700; font-size: 0.9rem; min-width: 36px; text-align: center; }
  .delta-bar-container { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .delta-bar-track {
    width: 100%; height: 20px; background: var(--bg-card-hover); border-radius: 10px;
    position: relative; overflow: hidden;
  }
  .delta-center-line {
    position: absolute; left: 50%; top: 0; bottom: 0; width: 2px;
    background: var(--text-dim); opacity: 0.3; transform: translateX(-50%);
  }
  .delta-bar-fill {
    position: absolute; top: 0; bottom: 0; border-radius: 10px;
  }
  .delta-bar-left { border-radius: 10px 0 0 10px; }
  .delta-bar-right { border-radius: 0 10px 10px 0; }
  .delta-value {
    font-size: 1.4rem; font-weight: 800; font-family: 'SF Mono', 'Fira Code', monospace;
  }

  /* ===== ストラテジータイムライン ===== */
  .strategy-section {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px;
    padding: 20px; margin-bottom: 24px;
  }
  .stint-row {
    display: flex; align-items: center; gap: 12px; margin-bottom: 8px;
  }
  .stint-drv { font-weight: 700; font-size: 0.9rem; min-width: 36px; text-align: center; }
  .stint-timeline {
    flex: 1; height: 28px; display: flex; border-radius: 4px; overflow: hidden;
    position: relative; gap: 2px;
  }
  .stint-block {
    display: flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.02em;
    border-radius: 3px;
  }
  .stint-label { white-space: nowrap; }
  .pit-marker {
    position: absolute; top: -4px; bottom: -4px; width: 2px;
    transform: translateX(-50%);
  }
  .pit-line { width: 2px; height: 100%; background: var(--text); opacity: 0.5; }
  .stint-axis {
    display: flex; justify-content: space-between; margin-top: 4px; margin-left: 48px;
    font-size: 0.7rem; color: var(--text-dim);
  }

  /* ===== セクター比較 ===== */
  .sector-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 40px; }
  .sector-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 16px; }
  .sec-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .sec-name { font-size: 0.85rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; }
  .sec-winner { font-size: 0.85rem; font-weight: 700; }

  .sec-delta-bar { margin-bottom: 4px; }
  .sec-delta-track {
    width: 100%; height: 12px; background: var(--bg-card-hover); border-radius: 6px;
    position: relative; overflow: hidden;
  }
  .sec-delta-center {
    position: absolute; left: 50%; top: 0; bottom: 0; width: 2px;
    background: var(--text-dim); opacity: 0.3; transform: translateX(-50%);
  }
  .sec-delta-fill { position: absolute; top: 0; bottom: 0; border-radius: 6px; }
  .sec-delta-num {
    font-size: 1.1rem; font-weight: 800; font-family: 'SF Mono', 'Fira Code', monospace;
    text-align: center; margin: 4px 0;
  }

  .sec-wins-bar { display: flex; height: 8px; border-radius: 4px; overflow: hidden; margin-top: 8px; }
  .sec-bar-d1 { border-radius: 4px 0 0 4px; }
  .sec-bar-d2 { border-radius: 0 4px 4px 0; }
  .sec-wins-labels { display: flex; justify-content: space-between; margin-top: 4px; font-size: 0.75rem; font-weight: 600; }

  /* ===== スピードバー ===== */
  .speed-bars { display: flex; flex-direction: column; gap: 16px; margin-bottom: 40px; }
  .speed-row {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px;
    padding: 16px; display: flex; align-items: center; gap: 16px;
  }
  .speed-label { font-size: 0.85rem; font-weight: 700; min-width: 60px; color: var(--text-dim); }
  .speed-pair { flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .speed-bar-row { display: flex; align-items: center; gap: 8px; }
  .speed-drv { font-size: 0.75rem; font-weight: 700; min-width: 32px; }
  .speed-bar-wrap { flex: 1; height: 10px; background: var(--bg-card-hover); border-radius: 5px; overflow: hidden; }
  .speed-bar-fill { height: 100%; border-radius: 5px; }
  .speed-val { font-size: 0.75rem; color: var(--text-dim); min-width: 32px; text-align: right; font-family: 'SF Mono', 'Fira Code', monospace; }
  .speed-delta-badge { font-size: 0.8rem; font-weight: 700; min-width: 90px; text-align: right; white-space: nowrap; }

  /* ===== ナビカード ===== */
