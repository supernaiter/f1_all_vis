---
import Base from '../../../layouts/Base.astro';
import SubNav from '../../../components/SubNav.astro';
import { getH2HStaticPaths, loadH2HAnalysis, TEAM_COLORS, DRIVER_HEADSHOTS } from '../../../lib/data';
import { hubPaceOneLiner, hubSectorOneLiner, hubSpeedOneLiner, hubStintOneLiner } from '../../../lib/insights';

export function getStaticPaths() { return getH2HStaticPaths(); }

const { dirName, pairDir, gpMeta } = Astro.props;
const analysis = loadH2HAnalysis(dirName, pairDir);
if (!analysis) return Astro.redirect('/');

const { meta, race_result, pace, sectors, speed, seo } = analysis;
const drv1 = meta.driver1;
const drv2 = meta.driver2;
const color1 = TEAM_COLORS[meta.team1] || '#999';
const color2 = TEAM_COLORS[meta.team2] || '#999';
const r1 = race_result[drv1];
const r2 = race_result[drv2];
const totalLaps = meta.total_laps;
const basePath = `/h2h/${meta.year}-r${String(meta.round).padStart(2, '0')}-${meta.gp_name.toLowerCase()}/${drv1.toLowerCase()}-vs-${drv2.toLowerCase()}/`;

// ヘッダー：レース結果で勝った方を大きく
const raceWinner = r1.finish < r2.finish ? 1 : r2.finish < r1.finish ? 2 : 0;

// ポジション変動
function posChange(grid: number, finish: number) {
  const diff = grid - finish;
  if (diff > 0) return { arrow: '▲', cls: 'pos-up', text: `+${diff}` };
  if (diff < 0) return { arrow: '▼', cls: 'pos-down', text: `${diff}` };
  return { arrow: '—', cls: 'pos-same', text: '±0' };
}
const pc1 = posChange(r1.grid, r1.finish);
const pc2 = posChange(r2.grid, r2.finish);

// タイヤカラー
const TYRE_COLORS: Record<string, string> = {
  SOFT: '#FF3333', MEDIUM: '#FFD700', HARD: '#FFFFFF',
  INTERMEDIATE: '#39B54A', WET: '#0072CE',
};

// --- スコアカード行データ ---
// winner: 1 or 2, size1/size2: ドットサイズ(px), opacity1/opacity2
interface ScoreRow {
  label: string;
  sub: string;
  subColor: string;
  val1: string;
  val2: string;
  // 0〜1のスケール値（CSSで実サイズに変換）
  scale1: number;
  scale2: number;
  opacity1: number;
  opacity2: number;
  fontSize1: number;
  fontSize2: number;
}

function makeRow(
  label: string, sub: string, subColor: string,
  val1: string, val2: string,
  v1: number, v2: number, maxDelta: number, lowerIsBetter: boolean
): ScoreRow {
  const diff = v1 - v2;
  const intensity = Math.min(Math.abs(diff) / maxDelta, 1);
  const winner = lowerIsBetter
    ? (diff < 0 ? 1 : diff > 0 ? 2 : 0)
    : (diff > 0 ? 1 : diff < 0 ? 2 : 0);

  // scale: 0.3(最小)〜1.0(最大)  差が大きいほど勝者が大きく敗者が小さい
  const winScale = 0.6 + intensity * 0.4;   // 0.6〜1.0
  const loseScale = 0.6 - intensity * 0.35; // 0.6〜0.25
  const drawScale = 0.5;

  // 透明度
  const winOpacity = 1;
  const loseOpacity = 0.7 - intensity * 0.35; // 0.7〜0.35

  // フォントサイズ（rem）
  const winFont = 0.85 + intensity * 0.25;  // 0.85〜1.1rem
  const loseFont = 0.85 - intensity * 0.15; // 0.85〜0.7rem

  return {
    label, sub, subColor, val1, val2,
    scale1: winner === 1 ? winScale : winner === 2 ? loseScale : drawScale,
    scale2: winner === 2 ? winScale : winner === 1 ? loseScale : drawScale,
    opacity1: winner === 2 ? loseOpacity : winOpacity,
    opacity2: winner === 1 ? loseOpacity : winOpacity,
    fontSize1: winner === 1 ? winFont : winner === 2 ? loseFont : 0.85,
    fontSize2: winner === 2 ? winFont : winner === 1 ? loseFont : 0.85,
  };
}

// ペース
const paceRow = makeRow(
  'Pace', `${Math.abs(pace.delta_median_sec ?? 0).toFixed(3)}s/lap`,
  pace.faster === drv1 ? color1 : color2,
  `${pace.drv1.median.toFixed(3)}s`, `${pace.drv2.median.toFixed(3)}s`,
  pace.drv1.median, pace.drv2.median, 0.5, true
);

// セクター
const sectorRows = Object.entries(sectors).map(([name, data]: [string, any]) => {
  const d1W = data[`${drv1}_wins`] ?? 0;
  const d2W = data[`${drv2}_wins`] ?? 0;
  const total = d1W + d2W;
  const delta = data.delta_sec ?? 0;
  return makeRow(
    name,
    `${delta > 0 ? '+' : ''}${delta.toFixed(3)}s`,
    delta < 0 ? color1 : color2,
    `${d1W} wins`, `${d2W} wins`,
    d1W, d2W, Math.max(total, 1), false
  );
});

// スピード
const speedRows = (Object.entries(speed) as [string, any][]).map(([label, data]) => {
  const v1 = data[`${drv1}_median`] ?? 0;
  const v2 = data[`${drv2}_median`] ?? 0;
  const delta = data.delta_kmh ?? 0;
  return makeRow(
    label,
    `${delta > 0 ? '+' : ''}${delta} km/h`,
    delta > 0 ? color1 : color2,
    `${v1}`, `${v2}`,
    v1, v2, 15, false
  );
});

const allRows = [paceRow, ...sectorRows, ...speedRows];

// スコアカード用の顔画像URL
const face1 = DRIVER_HEADSHOTS[drv1] || '';
const face2 = DRIVER_HEADSHOTS[drv2] || '';

// ナビカード
const navIcons: Record<string, string> = {
  Pace: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  Sectors: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20"/><line x1="12" y1="2" x2="12" y2="12"/><line x1="12" y1="12" x2="22" y2="12"/></svg>`,
  Speed: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  Stints: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1.5" fill="currentColor"/><circle cx="4" cy="12" r="1.5" fill="currentColor"/><circle cx="4" cy="18" r="1.5" fill="currentColor"/></svg>`,
};
const subPages = [
  { href: `${basePath}pace/`, label: 'Pace', desc: hubPaceOneLiner(analysis), icon: navIcons.Pace },
  { href: `${basePath}sectors/`, label: 'Sectors', desc: hubSectorOneLiner(analysis), icon: navIcons.Sectors },
  { href: `${basePath}speed/`, label: 'Speed', desc: hubSpeedOneLiner(analysis), icon: navIcons.Speed },
  { href: `${basePath}stints/`, label: 'Stints', desc: hubStintOneLiner(analysis), icon: navIcons.Stints },
];

const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: seo.title, description: seo.description, keywords: seo.keywords.join(', ') };
---

<Base title={seo.title_ja} description={seo.description} keywords={seo.keywords}>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<nav class="breadcrumb">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
  <a href="/">Home</a> &rsaquo;
  <a href="/">R{String(meta.round).padStart(2, '0')} {meta.gp_name}</a> &rsaquo;
  <span>{drv1} vs {drv2}</span>
</nav>

<!-- ===== ヒーロー ===== -->
<header class="hero">
  <div class={`hero-driver ${raceWinner === 1 ? 'winner' : raceWinner === 2 ? 'loser' : ''}`}>
    <div class="hero-portrait" style={`border-color: ${color1};`}>
      {DRIVER_HEADSHOTS[drv1] && <img src={DRIVER_HEADSHOTS[drv1]} alt={drv1} />}
    </div>
    <span class="hero-name" style={`color: ${color1};`}>{drv1}</span>
    <div class="hero-result">
      <span class="hero-pos" style={`background: ${color1};`}>P{r1.finish}</span>
      <span class={pc1.cls}>{pc1.arrow}{pc1.text}</span>
    </div>
  </div>

  <div class="hero-center">
    <span class="hero-vs">VS</span>
    <span class="hero-gp">{meta.year} R{String(meta.round).padStart(2, '0')}</span>
    <span class="hero-gp-name">{meta.gp_name} GP</span>
  </div>

  <div class={`hero-driver ${raceWinner === 2 ? 'winner' : raceWinner === 1 ? 'loser' : ''}`}>
    <div class="hero-portrait" style={`border-color: ${color2};`}>
      {DRIVER_HEADSHOTS[drv2] && <img src={DRIVER_HEADSHOTS[drv2]} alt={drv2} />}
    </div>
    <span class="hero-name" style={`color: ${color2};`}>{drv2}</span>
    <div class="hero-result">
      <span class="hero-pos" style={`background: ${color2};`}>P{r2.finish}</span>
      <span class={pc2.cls}>{pc2.arrow}{pc2.text}</span>
    </div>
  </div>
</header>

<SubNav basePath={basePath} current="hub" drv1={drv1} drv2={drv2} />

<!-- ===== スコアカード ===== -->
<div class="scorecard">
  {allRows.map((row) => (
    <div class="score-row" style={`--s1: ${row.scale1}; --s2: ${row.scale2}; --o1: ${row.opacity1}; --o2: ${row.opacity2}; --fs1: ${row.fontSize1}rem; --fs2: ${row.fontSize2}rem;`}>
      <div class="score-side score-left">
        <div class="face-dot face-dot-1" style={`border-color: ${color1};`}>
          {face1 && <img src={face1} alt={drv1} />}
        </div>
        <span class="score-val score-val-1">{row.val1}</span>
      </div>

      <div class="score-center">
        <span class="score-title">{row.label}</span>
        <span class="score-sub" style={`color: ${row.subColor};`}>{row.sub}</span>
      </div>

      <div class="score-side score-right">
        <span class="score-val score-val-2">{row.val2}</span>
        <div class="face-dot face-dot-2" style={`border-color: ${color2};`}>
          {face2 && <img src={face2} alt={drv2} />}
        </div>
      </div>
    </div>
  ))}
</div>

<!-- ===== ストラテジータイムライン ===== -->
<div class="strategy-section">
  <h2 class="section-title">Strategy</h2>
  {[
    { drv: drv1, color: color1, stints: analysis.stints.drv1, result: r1 },
    { drv: drv2, color: color2, stints: analysis.stints.drv2, result: r2 },
  ].map(({ drv, color, stints }) => (
    <div class="stint-row">
      <span class="stint-drv" style={`color: ${color};`}>{drv}</span>
      <div class="stint-timeline">
        {(stints as any[]).map((s: any) => {
          const widthPct = (s.total_laps / totalLaps) * 100;
          const tyreColor = TYRE_COLORS[s.compound] || '#999';
          return (
            <div
              class="stint-block"
              style={`width: ${widthPct}%; background: ${tyreColor}; color: ${s.compound === 'HARD' ? '#15151e' : '#fff'};`}
              title={`${s.compound} ${s.total_laps}周`}
            >
              <span class="stint-label">{s.compound.charAt(0)}{s.total_laps}</span>
            </div>
          );
        })}
      </div>
    </div>
  ))}
  <div class="stint-axis">
    <span>L1</span>
    <span>L{Math.round(totalLaps / 2)}</span>
    <span>L{totalLaps}</span>
  </div>
</div>

<!-- ===== 詳細分析ナビ ===== -->
<h2 class="section-title">Detailed Analysis</h2>
<div class="nav-cards">
  {subPages.map(page => (
    <a href={page.href} class="nav-card">
      <div class="nav-card-header">
        <span class="nav-card-icon" set:html={page.icon} />
        <span class="nav-card-title">{page.label}</span>
      </div>
      <div class="nav-card-desc">{page.desc}</div>
      <span class="nav-card-arrow">&rarr;</span>
    </a>
  ))}
</div>

</Base>

<style>
  .breadcrumb { font-size: 0.85rem; color: var(--text-dim); margin-bottom: 24px; display: flex; align-items: center; gap: 6px; }
  .breadcrumb a { color: var(--text-dim); }

  /* ===== ヒーロー ===== */
  .hero {
    display: flex; align-items: center; justify-content: center; gap: 20px;
    margin-bottom: 24px; padding: 12px 0;
  }
  .hero-driver {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    min-width: 80px; transition: all 0.3s;
  }
  .hero-driver.winner .hero-portrait { width: 56px; height: 56px; }
  .hero-driver.winner .hero-name { font-size: 1.3rem; }
  .hero-driver.loser .hero-portrait { width: 44px; height: 44px; opacity: 0.6; }
  .hero-driver.loser .hero-name { font-size: 1rem; opacity: 0.6; }
  .hero-driver:not(.winner):not(.loser) .hero-portrait { width: 48px; height: 48px; }
  .hero-driver:not(.winner):not(.loser) .hero-name { font-size: 1.15rem; }

  .hero-portrait {
    border-radius: 50%; overflow: hidden; border: 3px solid;
    background: var(--bg-card);
  }
  .hero-portrait img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .hero-name { font-weight: 800; }
  .hero-result { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; }
  .hero-pos {
    font-weight: 900; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;
  }
  .pos-up { color: #28973e; font-weight: 700; }
  .pos-down { color: #ff2d27; font-weight: 700; }
  .pos-same { color: var(--text-dim); }

  .hero-center { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .hero-vs { font-size: 1.2rem; font-weight: 900; color: var(--text-dim); letter-spacing: 0.1em; }
  .hero-gp { font-size: 0.7rem; color: var(--text-dim); }
  .hero-gp-name { font-size: 0.85rem; color: var(--text-dim); font-weight: 600; }

  /* ===== スコアカード ===== */
  .scorecard {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
    overflow: hidden; margin-bottom: 32px;
  }

  .score-row {
    display: flex; align-items: center; padding: 12px 20px;
    border-bottom: 1px solid var(--border);
  }
  .score-row:last-child { border-bottom: none; }

  /* 基準サイズ（CSS custom propertiesでスケール） */
  .score-row {
    --face-base: clamp(28px, 6vw, 44px);
  }

  .score-side {
    flex: 1; display: flex; align-items: center; gap: clamp(6px, 1.5vw, 12px);
  }
  .score-left { justify-content: flex-start; opacity: var(--o1); }
  .score-right { justify-content: flex-end; opacity: var(--o2); }

  .face-dot {
    border-radius: 50%; flex-shrink: 0; overflow: hidden;
    border: 2px solid; background: var(--bg-card-hover);
    transition: all 0.3s ease;
  }
  .face-dot-1 {
    width: calc(var(--face-base) * var(--s1));
    height: calc(var(--face-base) * var(--s1));
  }
  .face-dot-2 {
    width: calc(var(--face-base) * var(--s2));
    height: calc(var(--face-base) * var(--s2));
  }
  .face-dot img {
    width: 100%; height: 100%; object-fit: cover; object-position: center top;
    display: block;
  }

  .score-val {
    font-family: 'SF Mono', 'Fira Code', monospace;
    color: var(--text); white-space: nowrap;
    transition: font-size 0.3s;
  }
  .score-val-1 { font-size: var(--fs1); font-weight: calc(400 + var(--s1) * 400); }
  .score-val-2 { font-size: var(--fs2); font-weight: calc(400 + var(--s2) * 400); }

  .score-center {
    min-width: clamp(70px, 12vw, 110px); text-align: center;
    display: flex; flex-direction: column; gap: 1px; flex-shrink: 0;
  }
  .score-title {
    font-size: clamp(0.65rem, 1.5vw, 0.8rem); font-weight: 700; color: var(--text);
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .score-sub { font-size: clamp(0.58rem, 1.2vw, 0.7rem); font-weight: 700; }

  /* ===== ストラテジー ===== */
  .section-title {
    font-size: 1.2rem; font-weight: 700; margin-bottom: 16px;
    padding-bottom: 8px; border-bottom: 1px solid var(--border);
  }
  .strategy-section { margin-bottom: 32px; }
  .stint-row { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
  .stint-drv { font-weight: 700; font-size: 0.85rem; min-width: 36px; text-align: center; }
  .stint-timeline {
    flex: 1; height: 28px; display: flex; border-radius: 4px;
    overflow: hidden; gap: 2px;
  }
  .stint-block {
    display: flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 700; border-radius: 3px;
  }
  .stint-label { white-space: nowrap; }
  .stint-axis {
    display: flex; justify-content: space-between; margin-top: 4px; margin-left: 48px;
    font-size: 0.65rem; color: var(--text-dim);
  }

  /* ===== ナビカード ===== */
  .nav-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-bottom: 40px; }
  .nav-card {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px;
    padding: 20px; text-decoration: none; color: var(--text);
    display: flex; flex-direction: column; gap: 8px; position: relative;
    transition: border-color 0.15s, background 0.15s;
  }
  .nav-card:hover { border-color: var(--accent); background: var(--bg-card-hover); text-decoration: none; }
  .nav-card-header { display: flex; align-items: center; gap: 8px; }
  .nav-card-icon { color: var(--accent); display: flex; align-items: center; }
  .nav-card-title { font-size: 1.1rem; font-weight: 700; }
  .nav-card-desc { font-size: 0.85rem; color: var(--text-dim); }
  .nav-card-arrow { position: absolute; top: 20px; right: 20px; color: var(--text-dim); font-size: 1.2rem; }

  /* ===== レスポンシブ ===== */
  @media (max-width: 640px) {
    .hero { gap: 10px; padding: 8px 0; }
    .hero-driver { min-width: 60px; }
    .hero-driver.winner .hero-portrait { width: 44px; height: 44px; }
    .hero-driver.winner .hero-name { font-size: 1.1rem; }
    .hero-driver.loser .hero-portrait { width: 32px; height: 32px; }
    .hero-driver.loser .hero-name { font-size: 0.85rem; }
    .hero-vs { font-size: 1rem; }
    .hero-pos { font-size: 0.75rem; padding: 2px 6px; }

    .score-row { padding: 10px 12px; --face-base: 32px; }
  }
</style>
